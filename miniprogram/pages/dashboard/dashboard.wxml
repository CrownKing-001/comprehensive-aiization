<!-- 总览 -->
<view class="page-wrap stack {{themeClass}}">

  <!-- 欢迎条 -->
  <view class="hero">
    <view class="hero-week">🔥 第 {{week}} 教学周</view>
    <view class="hero-date">
      {{dateText}}<text class="hero-wd">{{weekdayText}}</text>
    </view>
    <view class="hero-greet">{{greet}}</view>

    <!-- 钉到总览的倒计时 -->
    <view class="pin-row">
      <view class="pin-card {{compact ? 'is-compact' : ''}}" wx:for="{{pinned}}" wx:key="id">
        <view class="pin-label">距 {{item.label}}</view>
        <view class="pin-days">{{item.done ? '✓' : item.days}}</view>
        <view class="pin-unit">{{item.done ? '已完成' : '天'}}</view>
      </view>
      <view class="pin-add" wx:if="{{pinned.length === 0}}" data-url="/pages/milestones/milestones" bindtap="goPage">
        <view class="pin-add-plus">＋</view>
        <view class="pin-add-text">添加倒计时</view>
      </view>
    </view>
  </view>

  <!-- 指标卡 -->
  <view class="stat-grid">
    <view
      class="stat-card"
      wx:for="{{stats}}"
      wx:key="key"
      data-url="{{item.url}}"
      bindtap="goTab"
    >
      <view class="stat-top">
        <view class="icon-chip tone-{{item.tone}}">{{item.icon}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
      <view class="stat-value">
        <text class="stat-num">{{item.value}}</text>
        <text class="stat-unit">{{item.unit}}</text>
      </view>
      <view class="chip chip-{{item.tone}}">{{item.sub}}</view>
    </view>
  </view>

  <!-- 功能入口（tabBar 之外的页面都从这里进） -->
  <view class="card">
    <view class="card-head">
      <view class="icon-chip tone-sky">🧭</view>
      <view class="card-head-title">全部功能</view>
    </view>
    <view class="card-body">
      <view class="nav-grid">
        <view class="nav-item" data-url="/pages/diet/diet" bindtap="goPage">
          <view class="nav-icon tone-emerald">🍽️</view>
          <view class="nav-name">饮食记录</view>
          <view class="nav-sub">{{todayProtein}}/{{proteinTarget}}g</view>
        </view>
        <view class="nav-item" data-url="/pages/run/run" bindtap="goPage" wx:if="{{runEnabled}}">
          <view class="nav-icon tone-amber">🏃</view>
          <view class="nav-name">运动打卡</view>
          <view class="nav-sub">{{runDone}}/{{runTarget}} 次</view>
        </view>
        <view class="nav-item" data-url="/pages/health/health" bindtap="goPage">
          <view class="nav-icon tone-sky">⚖️</view>
          <view class="nav-name">体重作息</view>
          <view class="nav-sub">{{latestWeight ? latestWeight + ' kg' : '未记录'}}</view>
        </view>
        <view class="nav-item" data-url="/pages/analysis/analysis" bindtap="goPage">
          <view class="nav-icon tone-violet">📊</view>
          <view class="nav-name">智能分析</view>
          <view class="nav-sub">空闲时段</view>
        </view>
        <view class="nav-item" data-url="/pages/milestones/milestones" bindtap="goPage">
          <view class="nav-icon tone-rose">⭐</view>
          <view class="nav-name">重要事项</view>
          <view class="nav-sub">考试 / DDL</view>
        </view>
        <view class="nav-item" data-url="/pages/coursescan/coursescan" bindtap="goPage">
          <view class="nav-icon tone-sky">📷</view>
          <view class="nav-name">课表识别</view>
          <view class="nav-sub">粘贴导入</view>
        </view>
        <view class="nav-item" data-url="/pages/settings/settings" bindtap="goPage">
          <view class="nav-icon tone-slate">⚙️</view>
          <view class="nav-name">设置</view>
          <view class="nav-sub">备份 / 学期</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 今日时间轴 -->
  <view class="card">
    <view class="card-head">
      <view class="icon-chip tone-sky">🕐</view>
      <view class="card-head-title">今日时间轴</view>
      <view class="head-link" data-url="/pages/today/today" bindtap="goTab">查看详情 →</view>
    </view>
    <view class="card-body">
      <view class="empty" wx:if="{{timeline.length === 0}}">
        <view class="empty-icon">🕐</view>
        <view class="empty-text">今天没有课程安排，好好休息 🎉</view>
      </view>
      <view class="tl" wx:else>
        <view class="tl-item" wx:for="{{timeline}}" wx:key="id">
          <view class="tl-time">{{item.time}}</view>
          <view class="tl-body {{item.ongoing ? 'is-ongoing' : ''}} {{item.done ? 'is-done' : ''}}">
            <view class="tl-title-row">
              <text class="tl-title">{{item.title}}</text>
              <text class="chip chip-emerald" wx:if="{{item.ongoing}}">进行中</text>
              <text class="tl-min" wx:if="{{item.minutes > 0}}">{{item.minutes}} 分钟</text>
            </view>
            <view class="tl-sub" wx:if="{{item.sub}}">{{item.sub}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 待办速览 -->
  <view class="card">
    <view class="card-head">
      <view class="icon-chip tone-emerald">✅</view>
      <view class="card-head-title">待办速览</view>
      <view class="head-link" data-url="/pages/todos/todos" bindtap="goTab">全部 →</view>
    </view>
    <view class="card-body">
      <view class="empty" wx:if="{{openTodos.length === 0}}">
        <view class="empty-icon">✅</view>
        <view class="empty-text">没有待办，清爽 ✨</view>
      </view>
      <view class="mini-list" wx:else>
        <view class="mini-row" wx:for="{{openTodos}}" wx:key="id">
          <view class="dot dot-{{item.dot}}"></view>
          <view class="mini-text">{{item.text}}</view>
          <text class="chip chip-{{item.chipTone}}" wx:if="{{item.chipText}}">{{item.chipText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 作业倒计时 -->
  <view class="card">
    <view class="card-head">
      <view class="icon-chip tone-violet">📖</view>
      <view class="card-head-title">作业倒计时</view>
      <view class="head-link" data-url="/pages/assignments/assignments" bindtap="goTab">全部 →</view>
    </view>
    <view class="card-body">
      <view class="empty" wx:if="{{dueSoon.length === 0}}">
        <view class="empty-icon">📖</view>
        <view class="empty-text">没有未完成作业 🎉</view>
      </view>
      <view class="mini-list" wx:else>
        <view class="mini-row is-block" wx:for="{{dueSoon}}" wx:key="id">
          <view class="mini-row-top">
            <text class="mini-title">{{item.title}}</text>
            <text class="chip chip-{{item.chipTone}}">{{item.chipText}}</text>
          </view>
          <view class="mini-sub">{{item.course}} · {{item.due}}{{item.dueTime ? ' ' + item.dueTime : ''}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 身体数据 + 运动 -->
  <view class="card">
    <view class="card-head">
      <view class="icon-chip tone-rose">💗</view>
      <view class="card-head-title">身体数据</view>
    </view>
    <view class="card-body">
      <view class="two-col">
        <view>
          <view class="mini-sub">最新体重</view>
          <view class="big-num">{{latestWeight ? latestWeight + ' kg' : '--'}}</view>
        </view>
        <view>
          <view class="mini-sub">今日蛋白</view>
          <view class="big-num">{{todayProtein}} g</view>
        </view>
      </view>
      <view class="bar">
        <view class="bar-fill bar-emerald" style="width: {{todayProtein >= proteinTarget ? 100 : (proteinTarget > 0 ? todayProtein * 100 / proteinTarget : 0)}}%"></view>
      </view>
      <view class="mini-sub" style="margin-top: 14rpx;">
        {{todayProtein >= proteinTarget ? '今日蛋白已达标 ✅' : '还差 ' + (proteinTarget - todayProtein) + 'g，继续加餐'}}
      </view>
    </view>
  </view>

  <!-- 运动打卡 -->
  <view class="card" wx:if="{{runEnabled}}">
    <view class="card-head">
      <view class="icon-chip tone-emerald">👟</view>
      <view class="card-head-title">运动打卡</view>
    </view>
    <view class="card-body">
      <view class="big-num">{{runDone}}<text class="big-sub"> / {{runTarget}}</text></view>
      <view class="bar">
        <view class="bar-fill bar-emerald" style="width: {{runDone >= runTarget ? 100 : runDone * 100 / runTarget}}%"></view>
      </view>
      <view class="mini-sub" style="margin-top: 14rpx;">
        {{runDone >= runTarget ? '已达成目标次数，保持住就行' : '继续加油 💪'}}
      </view>
    </view>
  </view>

  <!-- 今日饮食 -->
  <view class="card">
    <view class="card-head">
      <view class="icon-chip tone-amber">🍚</view>
      <view class="card-head-title">今日饮食</view>
      <text class="chip chip-amber">{{todayDietCount}} 笔</text>
    </view>
    <view class="card-body">
      <view class="big-num">{{todayCalories}}<text class="big-sub"> kcal</text></view>
      <view class="bar">
        <view class="bar-fill bar-amber" style="width: {{todayCalories >= 2400 ? 100 : todayCalories * 100 / 2400}}%"></view>
      </view>
      <view class="mini-sub" style="margin-top: 14rpx;">
        {{todayDietCount ? '已记 ' + todayDietCount + ' 笔，' + todayProtein + 'g 蛋白' : '今天还没记饮食'}}
      </view>
    </view>
  </view>

  <!-- 逾期警示 -->
  <view class="alert alert-rose" wx:if="{{overdue.length > 0}}">
    <text>⚠️ 有 <text class="bold">{{overdue.length}}</text> 个作业已经逾期：{{overdueTitles}}{{overdue.length > 3 ? ' 等' : ''}}</text>
  </view>

</view>
