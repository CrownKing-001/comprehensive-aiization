<!-- 总览 —— 「总览 / 今日」合并页。
     微信 tabBar 硬上限 5 格，为了让「设置」进菜单，把「今日」并进总览。
     两段各自的模板由 tools/prefix-wxml.js 从原页面生成（根标识符加模块前缀），
     外层只负责画分段控件。机制见 utils/tabHost.js。 -->
<view class="page-wrap stack {{themeClass}}">

  <!-- 分段切换 -->
  <view class="seg-bar">
    <view
      class="seg-item {{seg === item.id ? 'is-active' : ''}}"
      wx:for="{{segments}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="switchSeg"
    >
      <text class="seg-icon">{{item.icon}}</text>
      <text class="seg-label">{{item.label}}</text>
    </view>
  </view>

  <!-- ── 总览 ── -->
  <block wx:if="{{seg === 'dashboard'}}">
  <!-- 当前教学周没被确认过：摆最上面。确认一次后永久消失；
       设置页「学期与日期」里始终保留入口。见 store.setCurrentWeek。 -->
  <view class="week-setup" wx:if="{{!dashboard_weekConfirmed}}">
    <view class="week-setup-top">
      <text class="week-setup-emoji">📅</text>
      <view class="week-setup-copy">
        <view class="week-setup-title">现在是第几教学周？</view>
        <view class="week-setup-sub">选对之后，课表、作业、运动打卡的周次才会跟你对齐</view>
      </view>
    </view>
    <view class="week-setup-row">
      <picker class="week-setup-pick" mode="selector" range="{{dashboard_weekOptions}}"
        value="{{dashboard_weekPickIndex}}" bindchange="dashboard_onWeekPick">
        <view class="week-setup-value">
          <text>{{dashboard_weekOptions[dashboard_weekPickIndex]}}</text>
          <text class="week-setup-caret">▾</text>
        </view>
      </picker>
      <view class="week-setup-go" bindtap="dashboard_confirmWeek">就是这个</view>
    </view>
    <view class="week-setup-foot">确认后这条提示就收起来，之后在「设置 → 学期与日期」里随时能改</view>
  </view>
  <!-- 欢迎条 -->
  <view class="hero">
    <view class="hero-week">🔥 第 {{dashboard_week}} 教学周</view>
    <view class="hero-date">
      {{dashboard_dateText}}<text class="hero-wd">{{dashboard_weekdayText}}</text>
    </view>
    <view class="hero-greet">{{dashboard_greet}}</view>

    <!-- 钉到总览的倒计时 -->
    <view class="pin-row">
      <view class="pin-card {{dashboard_compact ? 'is-compact' : ''}} {{dashboard_pinEditId === item.id ? 'is-editing' : ''}}"
        wx:for="{{dashboard_pinned}}" wx:key="id">

        <!-- 就地编辑（桌面版是 hover 出铅笔；手机没有 hover，点卡片进入） -->
        <block wx:if="{{dashboard_pinEditId === item.id}}">
          <input class="pin-edit-input" value="{{dashboard_pinDraftTitle}}"
            data-id="{{item.id}}" bindinput="dashboard_onPinTitle"
            placeholder="名称" placeholder-class="pin-edit-ph" cursor-spacing="24" />
          <picker mode="date" value="{{dashboard_pinDraftDate}}" data-id="{{item.id}}" bindchange="dashboard_onPinDate">
            <view class="pin-edit-date">{{dashboard_pinDraftDate || '选择日期'}}</view>
          </picker>
          <view class="pin-edit-actions">
            <view class="pin-edit-btn is-save" data-id="{{item.id}}" catchtap="dashboard_savePinEdit">保存</view>
            <view class="pin-edit-btn" catchtap="dashboard_cancelPinEdit">取消</view>
          </view>
        </block>

        <block wx:else>
          <!-- 手机上没法用 hover，撤下按钮直接常显 -->
          <view class="pin-x" data-id="{{item.id}}" catchtap="dashboard_unpinMilestone">✕</view>
          <view class="pin-tap" data-id="{{item.id}}" catchtap="dashboard_startPinEdit">
            <view class="pin-label">距 {{item.label}}</view>
            <view class="pin-days">{{item.done ? '✓' : item.days}}</view>
            <view class="pin-unit">{{item.done ? '已完成' : '天'}}</view>
          </view>
        </block>
      </view>

      <!-- 添加 = 从「重要事项」里挑一个，不新建，保证两边共用一份数据 -->
      <view class="pin-add {{dashboard_pinned.length === 0 ? 'is-empty' : ''}}" bindtap="dashboard_togglePinPicker">
        <view class="pin-add-plus">＋</view>
        <view class="pin-add-text">{{dashboard_pinned.length === 0 ? '添加倒计时' : '添加'}}</view>
        <view class="pin-add-hint" wx:if="{{dashboard_pinned.length === 0}}">从重要事项里挑</view>
      </view>
    </view>

    <!-- 选择器：列出还没钉上的事项 -->
    <view class="pin-picker" wx:if="{{dashboard_pinPickerOpen}}">
      <view class="pin-picker-head">从「重要事项」中选择（已显示的不会再列出）</view>
      <view class="pin-picker-empty" wx:if="{{dashboard_availablePins.length === 0}}">
        <text>重要事项里已经没有可添加的了</text>
        <text class="pin-picker-link" bindtap="dashboard_goMilestones">去新建 →</text>
      </view>
      <view
        class="pin-picker-item"
        wx:for="{{dashboard_availablePins}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="dashboard_pinMilestone"
      >
        <text class="pin-picker-emoji">{{item.emoji}}</text>
        <view class="pin-picker-body">
          <text class="pin-picker-title">{{item.title}}</text>
          <text class="pin-picker-meta">{{item.date}}{{item.category ? ' · ' + item.category : ''}}</text>
        </view>
        <text class="pin-picker-days">{{item.daysText}}</text>
      </view>
    </view>
  </view>

  <!-- 指标卡 -->
  <view class="stat-grid">
    <view
      class="stat-card"
      wx:for="{{dashboard_stats}}"
      wx:key="key"
      data-url="{{item.url}}"
      data-seg="{{item.seg}}"
      data-is-tab="{{item.isTab}}"
      bindtap="dashboard_goStat"
    >
      <view class="stat-top">
        <view class="icon-chip tone-{{item.tone}}">{{item.icon}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
      <view class="stat-value">
        <text class="stat-num">{{item.value}}</text>
        <text class="stat-unit">{{item.unit}}</text>
      </view>
      <view class="chip chip-{{item.tone}}">{{item.sub}}</view>
    </view>
  </view>

  <!-- 功能入口（tabBar 之外的页面都从这里进） -->
  <view class="card rise-in">
    <view class="card-head">
      <view class="icon-chip tone-sky">🧭</view>
      <view class="card-head-title">全部功能</view>
    </view>
    <view class="card-body">
      <view class="nav-grid">
        <view class="nav-item" data-url="/pages/healthhub/healthhub" data-seg="diet" bindtap="dashboard_goTab">
          <view class="nav-icon tone-emerald">🍽️</view>
          <view class="nav-name">饮食记录</view>
          <view class="nav-sub">{{dashboard_todayProtein}}/{{dashboard_proteinTarget}}g</view>
        </view>
        <view class="nav-item" data-url="/pages/healthhub/healthhub" data-seg="run" bindtap="dashboard_goTab" wx:if="{{dashboard_runEnabled}}">
          <view class="nav-icon tone-amber">🏃</view>
          <view class="nav-name">运动打卡</view>
          <view class="nav-sub">{{dashboard_runDone}}/{{dashboard_runTarget}} 次</view>
        </view>
        <view class="nav-item" data-url="/pages/healthhub/healthhub" data-seg="health" bindtap="dashboard_goTab">
          <view class="nav-icon tone-sky">⚖️</view>
          <view class="nav-name">体重作息</view>
          <view class="nav-sub">{{dashboard_latestWeight ? dashboard_latestWeight + ' kg' : '未记录'}}</view>
        </view>
        <view class="nav-item" data-url="/pages/analysis/analysis" bindtap="dashboard_goPage">
          <view class="nav-icon tone-violet">📊</view>
          <view class="nav-name">智能分析</view>
          <view class="nav-sub">空闲时段</view>
        </view>
        <view class="nav-item" data-url="/pages/week/week" bindtap="dashboard_goPage">
          <view class="nav-icon tone-emerald">🗓️</view>
          <view class="nav-name">周计划</view>
          <view class="nav-sub">按周看课</view>
        </view>
        <view class="nav-item" data-url="/pages/milestones/milestones" bindtap="dashboard_goPage">
          <view class="nav-icon tone-rose">⭐</view>
          <view class="nav-name">重要事项</view>
          <view class="nav-sub">考试 / DDL</view>
        </view>
        <view class="nav-item" data-url="/pages/coursescan/coursescan" bindtap="dashboard_goPage">
          <view class="nav-icon tone-sky">📷</view>
          <view class="nav-name">课表识别</view>
          <view class="nav-sub">粘贴导入</view>
        </view>
        <view class="nav-item" data-url="/pages/calendaracademic/calendaracademic" bindtap="dashboard_goPage">
          <view class="nav-icon tone-amber">🎓</view>
          <view class="nav-name">校历识别</view>
          <view class="nav-sub">关键日期</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 今日时间轴 -->
  <view class="card rise-in d1">
    <view class="card-head">
      <view class="icon-chip tone-sky">🕐</view>
      <view class="card-head-title">今日时间轴</view>
      <!-- 「今日」已并入总览，不再是 tabBar 页面。
           用 switchTab 打开 /pages/today/today 会**静默失败**（不报错也不跳），
           所以这里指向总览自己并带上 seg，由 onShow 消费 pendingSeg 切到今日段。 -->
      <view class="head-link" data-url="/pages/dashboard/dashboard" data-seg="today"
        bindtap="dashboard_goTab">查看详情 →</view>
    </view>
    <view class="card-body">
      <view class="empty" wx:if="{{dashboard_timeline.length === 0}}">
        <view class="empty-icon">🕐</view>
        <view class="empty-text">今天没有课程安排，好好休息 🎉</view>
      </view>
      <view class="tl" wx:else>
        <view class="tl-item" wx:for="{{dashboard_timeline}}" wx:key="id">
          <view class="tl-time">{{item.time}}</view>
          <view class="tl-body {{item.ongoing ? 'is-ongoing' : ''}} {{item.done ? 'is-done' : ''}}">
            <view class="tl-title-row">
              <text class="tl-title">{{item.title}}</text>
              <text class="chip chip-emerald" wx:if="{{item.ongoing}}">进行中</text>
              <text class="tl-min" wx:if="{{item.minutes > 0}}">{{item.minutes}} 分钟</text>
            </view>
            <view class="tl-sub" wx:if="{{item.sub}}">{{item.sub}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 待办速览 -->
  <view class="card rise-in d2">
    <view class="card-head">
      <view class="icon-chip tone-emerald">✅</view>
      <view class="card-head-title">待办速览</view>
      <view class="head-link" data-url="/pages/tasks/tasks" data-seg="todos" bindtap="dashboard_goTab">全部 →</view>
    </view>
    <view class="card-body">
      <view class="empty" wx:if="{{dashboard_openTodos.length === 0}}">
        <view class="empty-icon">✅</view>
        <view class="empty-text">没有待办，清爽 ✨</view>
      </view>
      <view class="mini-list" wx:else>
        <view class="mini-row" wx:for="{{dashboard_openTodos}}" wx:key="id">
          <view class="dot dot-{{item.dot}}"></view>
          <view class="mini-text">{{item.text}}</view>
          <text class="chip chip-{{item.chipTone}}" wx:if="{{item.chipText}}">{{item.chipText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 作业倒计时 -->
  <view class="card">
    <view class="card-head">
      <view class="icon-chip tone-violet">📖</view>
      <view class="card-head-title">作业倒计时</view>
      <view class="head-link" data-url="/pages/tasks/tasks" data-seg="assignments" bindtap="dashboard_goTab">全部 →</view>
    </view>
    <view class="card-body">
      <view class="empty" wx:if="{{dashboard_dueSoon.length === 0}}">
        <view class="empty-icon">📖</view>
        <view class="empty-text">没有未完成作业 🎉</view>
      </view>
      <view class="mini-list" wx:else>
        <view class="mini-row is-block" wx:for="{{dashboard_dueSoon}}" wx:key="id">
          <view class="mini-row-top">
            <text class="mini-title">{{item.title}}</text>
            <text class="chip chip-{{item.chipTone}}">{{item.chipText}}</text>
          </view>
          <view class="mini-sub">{{item.course}} · {{item.due}}{{item.dueTime ? ' ' + item.dueTime : ''}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 身体数据 + 运动 -->
  <view class="card">
    <view class="card-head">
      <view class="icon-chip tone-rose">💗</view>
      <view class="card-head-title">身体数据</view>
      <view class="head-link" data-url="/pages/healthhub/healthhub" data-seg="health" bindtap="dashboard_goTab">记录 →</view>
    </view>
    <view class="card-body">
      <view class="two-col">
        <view>
          <view class="mini-sub">最新体重</view>
          <view class="big-num">{{dashboard_latestWeight ? dashboard_latestWeight + ' kg' : '--'}}</view>
        </view>
        <view>
          <view class="mini-sub">今日蛋白</view>
          <view class="big-num">{{dashboard_todayProtein}} g</view>
        </view>
      </view>
      <view class="bar">
        <view class="bar-fill bar-emerald" style="width: {{dashboard_todayProtein >= dashboard_proteinTarget ? 100 : (dashboard_proteinTarget > 0 ? dashboard_todayProtein * 100 / dashboard_proteinTarget : 0)}}%; --bar: {{(dashboard_todayProtein >= dashboard_proteinTarget ? 100 : (dashboard_proteinTarget > 0 ? dashboard_todayProtein * 100 / dashboard_proteinTarget : 0)) / 100}}"></view>
      </view>
      <view class="mini-sub" style="margin-top: 14rpx;">
        {{dashboard_todayProtein >= dashboard_proteinTarget ? '今日蛋白已达标 ✅' : '还差 ' + (dashboard_proteinTarget - dashboard_todayProtein) + 'g，继续加餐'}}
      </view>
      <view class="row-actions mt">
        <view class="btn-ghost btn-emerald" data-url="/pages/healthhub/healthhub" data-seg="health" bindtap="dashboard_goTab">⚖️ 体重作息</view>
        <view class="btn-ghost" data-url="/pages/healthhub/healthhub" data-seg="diet" bindtap="dashboard_goTab">🍽️ 饮食记录</view>
      </view>
    </view>
  </view>

  <!-- 运动打卡。关掉「运动打卡」时由下面的「重要事项」补位
       （桌面版 Dashboard.tsx:541-581 也是这个二选一）。 -->
  <view class="card" wx:if="{{dashboard_runEnabled}}">
    <view class="card-head">
      <view class="icon-chip tone-emerald">👟</view>
      <view class="card-head-title">运动打卡</view>
      <view class="head-link" data-url="/pages/healthhub/healthhub" data-seg="run" bindtap="dashboard_goTab">去打卡 →</view>
    </view>
    <view class="card-body">
      <view class="big-num">{{dashboard_runDone}}<text class="big-sub"> / {{dashboard_runTarget}}</text></view>
      <view class="bar">
        <view class="bar-fill bar-emerald" style="width: {{dashboard_runDone >= dashboard_runTarget ? 100 : dashboard_runDone * 100 / dashboard_runTarget}}%; --bar: {{(dashboard_runDone >= dashboard_runTarget ? 100 : dashboard_runDone * 100 / dashboard_runTarget) / 100}}"></view>
      </view>
      <view class="mini-sub" style="margin-top: 14rpx;">
        {{dashboard_runDone >= dashboard_runTarget ? '已达成目标次数，保持住就行' : '继续加油 💪'}}
      </view>
      <view class="row-actions mt">
        <view class="btn-ghost btn-emerald" data-url="/pages/healthhub/healthhub" data-seg="run" bindtap="dashboard_goTab">🏃 打开运动打卡</view>
      </view>
    </view>
  </view>

  <!-- 重要事项（运动打卡关闭时补位，桌面版 Dashboard.tsx:559-580）-->
  <view class="card" wx:else>
    <view class="card-head">
      <view class="icon-chip tone-rose">🎯</view>
      <view class="card-head-title">重要事项</view>
      <view class="head-link" bindtap="dashboard_goMilestones">去管理 →</view>
    </view>
    <view class="card-body">
      <view class="big-num">{{dashboard_undoneCount}}<text class="big-sub"> 项待办</text></view>
      <view class="mini-sub" style="margin-top: 14rpx;">
        {{dashboard_nextMilestoneText ? '最近一项：' + dashboard_nextMilestoneText : '还没有待办事项'}}
      </view>
      <view class="row-actions mt">
        <view class="btn-primary btn-sm" bindtap="dashboard_goMilestones">🎯 去管理</view>
        <view class="btn-ghost btn-sm" data-url="/pages/settings/settings" bindtap="dashboard_goTab">⚙️ 去设置</view>
      </view>
    </view>
  </view>

  <!-- 今日饮食 -->
  <view class="card">
    <view class="card-head">
      <view class="icon-chip tone-amber">🍚</view>
      <view class="card-head-title">今日饮食</view>
      <text class="chip chip-amber">{{dashboard_todayDietCount}} 笔</text>
      <view class="head-link" data-url="/pages/healthhub/healthhub" data-seg="diet" bindtap="dashboard_goTab">去记录 →</view>
    </view>
    <view class="card-body">
      <view class="big-num">{{dashboard_todayCalories}}<text class="big-sub"> kcal</text></view>
      <view class="bar">
        <view class="bar-fill bar-amber" style="width: {{dashboard_todayCalories >= 2400 ? 100 : dashboard_todayCalories * 100 / 2400}}%; --bar: {{(dashboard_todayCalories >= 2400 ? 100 : dashboard_todayCalories * 100 / 2400) / 100}}"></view>
      </view>
      <view class="mini-sub" style="margin-top: 14rpx;">
        {{dashboard_todayDietCount ? '已记 ' + dashboard_todayDietCount + ' 笔，' + dashboard_todayProtein + 'g 蛋白' : '今天还没记饮食'}}
      </view>
      <view class="row-actions mt">
        <view class="btn-ghost btn-emerald" data-url="/pages/healthhub/healthhub" data-seg="diet" bindtap="dashboard_goTab">🍽️ 打开饮食记录</view>
      </view>
    </view>
  </view>

  <!-- 逾期警示 -->
  <view class="alert alert-rose" wx:if="{{dashboard_overdue.length > 0}}">
    <text>⚠️ 有 <text class="bold">{{dashboard_overdue.length}}</text> 个作业已经逾期：{{dashboard_overdueTitles}}{{dashboard_overdue.length > 3 ? ' 等' : ''}}</text>
  </view>

  </block>

  <!-- ── 今日 ── -->
  <block wx:else><!-- 日期切换 -->
  <view class="date-bar">
    <view class="date-nav" bindtap="today_prevDay">‹</view>
    <view class="date-mid">
      <view class="date-main">
        {{today_dateStr}} · {{today_weekdayStr}}
        <text class="date-rel">{{today_relLabel}}</text>
      </view>
      <view class="date-week">第 {{today_week}} 教学周</view>
    </view>
    <view class="date-right">
      <view class="btn-back-today" wx:if="{{!today_isToday}}" bindtap="today_backToday">回到今天</view>
      <view class="date-nav" bindtap="today_nextDay">›</view>
    </view>
  </view>

  <!-- 课程 -->
  <view class="card">
    <view class="card-head">
      <view class="icon-chip tone-sky">📘</view>
      <view class="card-head-title">
        {{today_isToday ? '今日' : '当日'}}课程（{{today_isToday ? '还有 ' + today_shown.length : today_shown.length}} 节）
      </view>
      <view class="head-note" wx:if="{{today_finished > 0}}">✓ 已上完 {{today_finished}} 节</view>
    </view>
    <view class="card-body">
      <view class="empty" wx:if="{{today_shown.length === 0}}">
        <view class="empty-icon">🎉</view>
        <view class="empty-text">
          {{today_isToday && today_finished > 0 ? '今天的课都上完了 🎉' : '这一天没有课，时间都是你的 🎉'}}
        </view>
      </view>
      <view class="course-list" wx:else>
        <view class="course-item {{item.ongoing ? 'is-ongoing' : ''}}" wx:for="{{today_shown}}" wx:key="uid">
          <view class="course-main">
            <view class="course-name-row">
              <text class="course-name">{{item.name}}</text>
              <text class="chip chip-sky" wx:if="{{item.tag}}">{{item.tag}}</text>
              <text class="chip chip-emerald" wx:if="{{item.ongoing}}">进行中</text>
            </view>
            <view class="course-place">{{item.place}}</view>
          </view>
          <view class="course-time">{{item.start}}–{{item.end}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 当天要处理的事 -->
  <view class="card">
    <view class="card-head">
      <view class="icon-chip tone-emerald">✅</view>
      <view class="card-head-title">当天要处理的事</view>
    </view>
    <view class="card-body">
      <view class="empty" wx:if="{{today_dayTodos.length === 0 && today_dayAssign.length === 0}}">
        <view class="empty-icon">🎉</view>
        <view class="empty-text">没有到期的待办和作业 🎉</view>
      </view>
      <view wx:else>
        <view wx:if="{{today_dayTodos.length > 0}}">
          <view class="sec-label">待办</view>
          <view class="todo-list-wrap">
            <view class="todo-line" wx:for="{{today_dayTodos}}" wx:key="id">
              <view class="checkbox-sm" data-id="{{item.id}}" bindtap="today_toggleTodo"></view>
              <view class="todo-text">{{item.text}}</view>
              <text class="chip chip-rose" wx:if="{{item.overdue}}">逾期</text>
            </view>
          </view>
        </view>
        <view wx:if="{{today_dayAssign.length > 0}}" style="margin-top: 20rpx;">
          <view class="sec-label">作业</view>
          <view class="todo-list-wrap">
            <view class="todo-line" wx:for="{{today_dayAssign}}" wx:key="id">
              <view class="todo-icon">📖</view>
              <view class="todo-text"><text class="muted">{{item.course}} · </text>{{item.title}}</view>
              <text class="chip chip-{{item.chipTone}}">{{item.chipText}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 完整时间轴 -->
  <view class="card">
    <view class="card-head">
      <view class="icon-chip tone-violet">🕐</view>
      <view class="card-head-title">当日完整时间轴</view>
    </view>
    <view class="card-body">
      <view class="empty" wx:if="{{today_timeline.length === 0}}">
        <view class="empty-icon">🕐</view>
        <view class="empty-text">这一天没有任何安排</view>
      </view>
      <view class="tl" wx:else>
        <view class="tl-item" wx:for="{{today_timeline}}" wx:key="id">
          <view class="tl-time">{{item.time}}</view>
          <view class="tl-body {{item.ongoing ? 'is-ongoing' : ''}}">
            <view class="tl-title-row">
              <text class="tl-title">{{item.title}}</text>
              <text class="chip chip-emerald" wx:if="{{item.ongoing}}">进行中</text>
              <text class="tl-min" wx:if="{{item.minutes > 0}}">{{item.minutes}} 分钟</text>
            </view>
            <view class="tl-sub" wx:if="{{item.sub}}">{{item.sub}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="btn-ghost full" wx:if="{{!today_isToday}}" bindtap="today_backToday">回到今天</view>

  </block>

</view>