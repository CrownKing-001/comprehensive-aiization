/* 总览 · 今日 合并页样式：分段控件 + 两份原样式（重名的只保留 dashboard 那份）*/

/* ── 顶部分段切换 ── */
.seg-bar {
  display: flex;
  gap: 12rpx;
  padding: 10rpx;
  border-radius: 22rpx;
  background: var(--chip-bg);
  border: 2rpx solid var(--border);
}
.seg-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  padding: 18rpx 10rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--text-3);
  transition: background 0.15s, color 0.15s;
}
.seg-item.is-active {
  background: rgba(16, 185, 129, 0.16);
  color: #34d399;
  font-weight: 600;
}
.seg-icon { font-size: 26rpx; }
.seg-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.seg-badge {
  min-width: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.22);
  color: var(--text-3);
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}
.seg-item.is-active .seg-badge {
  background: rgba(16, 185, 129, 0.25);
  color: #34d399;
}

/* ── 总览部分（原 dashboard.wxss） ── */
/* 总览页样式。app.wxss 是全局样式，本就自动生效，无需 @import。 */

/* ── 欢迎条 ───────────────────────────────────── */
.hero {
  border-radius: 28rpx;
  padding: 36rpx 32rpx 30rpx;
  background: linear-gradient(135deg, #059669 0%, #047857 55%, #0f766e 100%);
  box-shadow: 0 16rpx 40rpx -14rpx rgba(4, 120, 87, 0.5);
  margin-bottom: 24rpx;
}

.hero-week {
  font-size: 23rpx;
  font-weight: 500;
  color: rgba(209, 250, 229, 0.92);
}

.hero-date {
  font-size: 46rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 10rpx;
  letter-spacing: -0.5rpx;
}

.hero-wd {
  font-size: 30rpx;
  font-weight: 500;
  color: rgba(209, 250, 229, 0.75);
  margin-left: 12rpx;
}

.hero-greet {
  font-size: 25rpx;
  color: rgba(209, 250, 229, 0.85);
  margin-top: 10rpx;
}

/* ── 钉住的倒计时 ─────────────────────────────── */
.pin-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 26rpx;
}

.pin-card {
  min-width: 168rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  text-align: center;
  /* 撤下按钮绝对定位在右上角 */
  position: relative;
}

/* 撤下：桌面版是 hover 才出现，手机没有 hover，所以常显。
   屏幕小、手指粗，可点区域给到 40rpx 见方，免得点不中。 */
.pin-x {
  position: absolute;
  top: 4rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.1);
}

.pin-card.is-compact {
  min-width: 130rpx;
  padding: 14rpx 16rpx;
}

.pin-label {
  font-size: 21rpx;
  color: rgba(209, 250, 229, 0.9);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 220rpx;
}

.pin-days {
  font-size: 54rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.15;
}

.pin-card.is-compact .pin-days { font-size: 42rpx; }

.pin-unit {
  font-size: 20rpx;
  color: rgba(209, 250, 229, 0.9);
}

.pin-add {
  min-width: 260rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.32);
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.pin-add-plus { font-size: 34rpx; color: rgba(255, 255, 255, 0.8); }
.pin-add-text { font-size: 20rpx; color: rgba(255, 255, 255, 0.75); }
.pin-add-hint { font-size: 19rpx; color: rgba(255, 255, 255, 0.45); }

/* 一个都没钉时，添加块要跟倒计时卡差不多高，
   否则绿色条上只剩一条小窄条，看起来像渲染坏了 */
.pin-add.is-empty { min-height: 176rpx; }

/* ── 「从重要事项里挑」选择器 ── */
.pin-picker {
  margin-top: 16rpx;
  padding: 12rpx;
  border-radius: 22rpx;
  background: rgba(0, 0, 0, 0.32);
  border: 2rpx solid rgba(255, 255, 255, 0.16);
}

.pin-picker-head {
  padding: 8rpx 12rpx 12rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
}

.pin-picker-empty {
  padding: 22rpx 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.pin-picker-link {
  margin-left: 8rpx;
  color: #34d399;
}

.pin-picker-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 12rpx;
  border-radius: 16rpx;
}

.pin-picker-emoji { font-size: 30rpx; flex-shrink: 0; }

.pin-picker-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pin-picker-title {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.92);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pin-picker-meta { font-size: 20rpx; color: rgba(255, 255, 255, 0.5); }

.pin-picker-days {
  font-size: 20rpx;
  color: rgba(209, 250, 229, 0.85);
  flex-shrink: 0;
}

/* ── 时间轴 ───────────────────────────────────── */
/* 时间轴：小程序不支持 :last-child，靠容器负下边距抵消末项间距 */
.tl { position: relative; margin-bottom: -18rpx; }

.tl-item {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.tl-time {
  width: 92rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-4);
  padding-top: 16rpx;
  font-variant-numeric: tabular-nums;
}

.tl-body {
  flex: 1;
  min-width: 0;
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--border-1);
}

.tl-body.is-ongoing {
  background: rgba(16, 185, 129, 0.1);
  border-color: rgba(16, 185, 129, 0.3);
}

.tl-body.is-done { opacity: 0.6; }

.tl-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tl-title {
  flex: 1;
  font-size: 27rpx;
  font-weight: 500;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tl-min { font-size: 20rpx; color: var(--text-4); }

.tl-sub {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 6rpx;
}

/* ── 迷你列表 ─────────────────────────────────── */
.mini-list { display: flex; flex-direction: column; gap: 12rpx; }

.mini-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--border-1);
  padding: 18rpx 22rpx;
}

.mini-row.is-block { display: block; }

.mini-row-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.mini-title {
  flex: 1;
  font-size: 25rpx;
  font-weight: 500;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-text {
  flex: 1;
  font-size: 25rpx;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-sub {
  font-size: 21rpx;
  color: var(--text-4);
  margin-top: 8rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-rose    { background: #f43f5e; }
.dot-emerald { background: #10b981; }
.dot-slate   { background: #64748b; }

/* ── 通用 ─────────────────────────────────────── */
.head-link {
  font-size: 23rpx;
  font-weight: 500;
  color: #34d399;
}

.two-col { display: flex; gap: 24rpx; }
.two-col > view { flex: 1; }

.big-num {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
  line-height: 1.25;
}

.big-sub {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-4);
}

.bar {
  width: 100%;
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--border-1);
  overflow: hidden;
  margin-top: 18rpx;
}

.bar-fill { height: 100%; border-radius: 999rpx; }
.bar-emerald { background: linear-gradient(90deg, #10b981, #2dd4bf); }
.bar-amber   { background: linear-gradient(90deg, #f59e0b, #fb923c); }

.alert {
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  font-size: 25rpx;
  margin-top: 24rpx;
}

.alert-rose {
  background: rgba(244, 63, 94, 0.1);
  border: 2rpx solid rgba(244, 63, 94, 0.3);
  color: #fda4af;
}

.bold { font-weight: 700; }

/* ── 功能入口网格 ─────────────────────────────── */
/* 用 grid 而非 flex-wrap：4 列在窄屏也稳，不会被 gap 挤溢 */
.nav-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 6rpx 16rpx;
  border-radius: 18rpx;
  border: 2rpx solid var(--border-2);
  background: var(--surface-3);
  min-width: 0;
}

.nav-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.nav-name {
  font-size: 21rpx;
  font-weight: 500;
  color: var(--text-2);
  text-align: center;
  line-height: 1.3;
}

.nav-sub {
  font-size: 18rpx;
  color: var(--text-4);
  text-align: center;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* ── 今日部分（原 today.wxss） ── */
/* 今日页样式。app.wxss 是全局样式，本就自动生效，无需 @import。 */

/* ── 日期切换条 ───────────────────────────────── */
.date-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--surface-1);
  border: 2rpx solid var(--border-1);
  border-radius: 28rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.date-nav {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: var(--surface-3);
  border: 2rpx solid var(--border-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  color: var(--text-3);
  flex-shrink: 0;
  line-height: 1;
}

.date-mid { flex: 1; text-align: center; min-width: 0; }

.date-main {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-1);
}

.date-rel {
  font-size: 22rpx;
  font-weight: 400;
  color: #34d399;
  margin-left: 12rpx;
}

.date-week {
  font-size: 21rpx;
  color: var(--text-4);
  margin-top: 4rpx;
}

.date-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.btn-back-today {
  font-size: 22rpx;
  font-weight: 500;
  color: #34d399;
  background: rgba(16, 185, 129, 0.15);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
}

.head-note { font-size: 22rpx; color: var(--text-4); }

/* ── 课程列表 ─────────────────────────────────── */
.course-list { display: flex; flex-direction: column; gap: 16rpx; }

.course-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-radius: 18rpx;
  padding: 22rpx 26rpx;
  background: rgba(14, 165, 233, 0.12);
  border: 2rpx solid transparent;
}

.course-item.is-ongoing {
  background: rgba(16, 185, 129, 0.12);
  border-color: rgba(16, 185, 129, 0.35);
}

.course-main { flex: 1; min-width: 0; }

.course-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.course-name {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-place {
  font-size: 23rpx;
  color: var(--text-4);
  margin-top: 6rpx;
}

.course-time {
  font-size: 27rpx;
  font-weight: 600;
  color: #38bdf8;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

/* ── 待处理 ───────────────────────────────────── */
.sec-label {
  font-size: 21rpx;
  color: var(--text-4);
  margin-bottom: 12rpx;
}

/* 小程序 WXSS 不支持 :last-child 等结构伪类，
   改用父容器的负下边距抵消最后一项的多余间距。 */
.todo-list-wrap { margin-bottom: -12rpx; }

.todo-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-radius: 16rpx;
  background: var(--surface-3);
  border: 2rpx solid var(--border-2);
  padding: 18rpx 22rpx;
  margin-bottom: 12rpx;
}

.checkbox-sm {
  width: 32rpx;
  height: 32rpx;
  border-radius: 10rpx;
  border: 3rpx solid #475569;
  flex-shrink: 0;
}

.todo-icon { font-size: 24rpx; flex-shrink: 0; }

.todo-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.muted { color: var(--text-4); }

/* ── 时间轴 ───────────────────────────────────── */
/* 时间轴：同样不用 :last-child，靠容器负边距收尾 */









.full { width: 100%; box-sizing: border-box; }
