/* 总览 · 今日 合并页样式：分段控件 + 两份原样式（重名的只保留 dashboard 那份）*/

/* ── 顶部分段切换 ── */
.seg-bar {
  display: flex;
  gap: 12rpx;
  padding: 10rpx;
  border-radius: 20rpx;
  background: var(--chip-bg);
  border: 2rpx solid var(--border);
}
.seg-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  padding: 18rpx 10rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-3);
  transition: background 0.15s, color 0.15s;
}
.seg-item.is-active {
  background: rgba(16, 185, 129, 0.16);
  color: #34d399;
  font-weight: 600;
}
.seg-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.seg-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 注：这里原来还有 .seg-badge / .seg-item.is-active .seg-badge 两组规则，
   是从 tasks 抄过来的死代码 —— 总览页的分段栏没有角标，
   WXML 里根本不存在这个类名。已删除（tools/check-selectors.js 会报出来）。 */

/* ── 总览部分（原 dashboard.wxss） ── */
/* 总览页样式。app.wxss 是全局样式，本就自动生效，无需 @import。 */

/* ── 「现在是第几教学周」醒目提示 ─────────────────
   只在 settings.weekConfirmed 为 false 时出现（首装默认 false）。
   为什么需要它：semesterStart 兜底成「本周一」，于是首装就显示「第 1 教学周」，
   和「用户真在第 1 周」从数据上分不出来 —— 用户普遍不知道自己该改这里。
   确认一次后永久收起；设置页「学期与日期」里仍保留入口。
   它不是 .card，所以拿不到 .stack > .card + .card 的间距，自己给下边距。 */
.week-setup {
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.16), rgba(5, 150, 105, 0.07));
  border: 2rpx solid rgba(52, 211, 153, 0.34);
}

.week-setup-top {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

/* 原来是一个 40rpx 的 emoji 字形（字体渲染、基线不可控）。
   换成 ui-icon 后这个类只管盒子：图形大小由 <ui-icon size> 以 px 给定，
   不再随 font-size 缩放，因此也不会像 emoji 那样撑出容器。 */
.week-setup-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.week-setup-copy {
  flex: 1;
  min-width: 0;
}

.week-setup-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.week-setup-sub {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.week-setup-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
}

.week-setup-pick {
  flex: 1;
  min-width: 0;
}

.week-setup-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--surface-0);
  border: 2rpx solid var(--border-2);
  color: var(--text-1);
  font-size: 30rpx;
  font-weight: 500;
}

.week-setup-caret {
  color: var(--text-4);
  font-size: 24rpx;
}

.week-setup-go {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  background: #047857;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
}

.week-setup-foot {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--text-4);
  line-height: 1.5;
}

/* ── 欢迎条 ─────────────────────────────────────
   原来是绿色三色渐变 + 44rpx 彩色外投影，是全站「最花」的一块。
   改成单色实底 + 极轻描边：信息层级靠字号和留白建立，不靠渐变和投影。

   ⚠️ 文字色必须用 token，不能写死 rgba(209,250,229) 这类「浅绿白」。
   那种值是为深色渐变底调的；浅色主题下 hero 底变成浅绿（#f0fdf4），
   浅绿白字压上去只剩 1.1:1，等于看不见。
   现在深色主题 hero 是深靛底配浅字，浅色主题是浅绿底配深字，
   三处文字色各自走 token，两套主题都成立。 */
.hero {
  border-radius: 20rpx;
  padding: 32rpx 32rpx 28rpx;
  background: var(--hero-bg);
  border: 1rpx solid var(--hero-border);
  margin-bottom: 24rpx;
}

.hero-week {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--hero-text-weak);
}

.hero-date {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--hero-text-strong);
  margin-top: 10rpx;
  letter-spacing: -0.5rpx;
}

.hero-wd {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--hero-text-weak);
  margin-left: 12rpx;
}

.hero-greet {
  font-size: 28rpx;
  color: var(--hero-text-body);
  margin-top: 10rpx;
}

/* ── 钉住的倒计时 ─────────────────────────────── */
.pin-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 26rpx;
}

.pin-card {
  min-width: 168rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  text-align: center;
  /* 撤下按钮绝对定位在右上角 */
  position: relative;
}

/* 撤下：桌面版是 hover 才出现，手机没有 hover，所以常显。
   屏幕小、手指粗，可点区域给到 40rpx 见方，免得点不中。 */
.pin-x {
  position: absolute;
  top: 4rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.1);
}

.pin-card.is-compact {
  min-width: 130rpx;
  padding: 14rpx 16rpx;
}

.pin-label {
  font-size: 24rpx;
  color: rgba(209, 250, 229, 0.9);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 220rpx;
}

.pin-days {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.15;
}

.pin-card.is-compact .pin-days { font-size: 34rpx; }

.pin-unit {
  font-size: 24rpx;
  color: rgba(209, 250, 229, 0.9);
}

.pin-add {
  min-width: 260rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.32);
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.pin-add-plus { font-size: 34rpx; color: rgba(255, 255, 255, 0.8); }
.pin-add-text { font-size: 24rpx; color: rgba(255, 255, 255, 0.75); }
.pin-add-hint { font-size: 24rpx; color: rgba(255, 255, 255, 0.62); }

/* 一个都没钉时，添加块要跟倒计时卡差不多高，
   否则绿色条上只剩一条小窄条，看起来像渲染坏了 */
.pin-add.is-empty { min-height: 176rpx; }

/* ── 「从重要事项里挑」选择器 ── */
.pin-picker {
  margin-top: 16rpx;
  padding: 12rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.32);
  border: 2rpx solid rgba(255, 255, 255, 0.16);
}

.pin-picker-head {
  padding: 8rpx 12rpx 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
}

.pin-picker-empty {
  padding: 22rpx 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.pin-picker-link {
  margin-left: 8rpx;
  color: #34d399;
}

.pin-picker-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 12rpx;
  border-radius: 16rpx;
}

.pin-picker-emoji { flex-shrink: 0; display: flex; align-items: center; }

.pin-picker-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pin-picker-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.92);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pin-picker-meta { font-size: 24rpx; color: rgba(255, 255, 255, 0.65); }

.pin-picker-days {
  font-size: 24rpx;
  color: rgba(209, 250, 229, 0.85);
  flex-shrink: 0;
}

/* ── 时间轴 ───────────────────────────────────── */
/* 时间轴：小程序不支持 :last-child，靠容器负下边距抵消末项间距 */
.tl { position: relative; margin-bottom: -18rpx; }

.tl-item {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.tl-time {
  width: 92rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-4);
  padding-top: 16rpx;
  font-variant-numeric: tabular-nums;
}

.tl-body {
  flex: 1;
  min-width: 0;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--border-1);
}

.tl-body.is-ongoing {
  background: rgba(16, 185, 129, 0.1);
  border-color: rgba(16, 185, 129, 0.3);
}

.tl-body.is-done { opacity: 0.6; }

.tl-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tl-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tl-min { font-size: 24rpx; color: var(--text-4); }

.tl-sub {
  font-size: 24rpx;
  color: var(--text-4);
  margin-top: 6rpx;
}

/* ── 迷你列表 ─────────────────────────────────── */
.mini-list { display: flex; flex-direction: column; gap: 12rpx; }

.mini-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--border-1);
  padding: 18rpx 22rpx;
}

.mini-row.is-block { display: block; }

.mini-row-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.mini-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-sub {
  font-size: 24rpx;
  color: var(--text-4);
  margin-top: 8rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-rose    { background: #f43f5e; }
.dot-emerald { background: #10b981; }
.dot-slate   { background: #64748b; }

/* ── 通用 ─────────────────────────────────────── */
.head-link {
  font-size: 28rpx;
  font-weight: 500;
  color: #34d399;
}

.two-col { display: flex; gap: 24rpx; }
.two-col > view { flex: 1; }

.big-num {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
  line-height: 1.25;
}

.big-sub {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-4);
}

.bar {
  width: 100%;
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--border-1);
  overflow: hidden;
  margin-top: 18rpx;
}

.bar-fill { height: 100%; border-radius: 999rpx; }
/* 进度条用单色。原来的 90° 双色渐变在小尺寸下只剩「一条亮线」，
   既看不出渐变，又让两个不同的进度条看起来是同一套皮肤。 */
.bar-emerald { background: #10b981; }
.bar-amber   { background: #f59e0b; }

.alert {
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  margin-top: 24rpx;
}

.alert-rose {
  background: rgba(244, 63, 94, 0.1);
  border: 2rpx solid rgba(244, 63, 94, 0.3);
  color: #fda4af;
}

.bold { font-weight: 700; }

/* ── 功能入口网格 ─────────────────────────────── */
/* 用 grid 而非 flex-wrap：4 列在窄屏也稳，不会被 gap 挤溢 */
.nav-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 6rpx 16rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border-2);
  background: var(--surface-3);
  min-width: 0;
}

.nav-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.nav-name {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-2);
  text-align: center;
  line-height: 1.3;
}

.nav-sub {
  font-size: 24rpx;
  color: var(--text-4);
  text-align: center;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* ── 今日部分（原 today.wxss） ── */
/* 今日页样式。app.wxss 是全局样式，本就自动生效，无需 @import。 */

/* ── 日期切换条 ───────────────────────────────── */
.date-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--surface-1);
  border: 2rpx solid var(--border-1);
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.date-nav {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: var(--surface-3);
  border: 2rpx solid var(--border-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: var(--text-3);
  flex-shrink: 0;
