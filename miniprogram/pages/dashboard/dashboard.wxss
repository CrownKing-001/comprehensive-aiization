}

.date-mid { flex: 1; text-align: center; min-width: 0; }

.date-main {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.date-rel {
  font-size: 24rpx;
  font-weight: 400;
  color: #34d399;
  margin-left: 12rpx;
}

.date-week {
  font-size: 24rpx;
  color: var(--text-4);
  margin-top: 4rpx;
}

.date-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.btn-back-today {
  font-size: 24rpx;
  font-weight: 500;
  color: #34d399;
  background: rgba(16, 185, 129, 0.15);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
}

.head-note { font-size: 24rpx; color: var(--text-4); }

/* ── 课程列表 ─────────────────────────────────── */
.course-list { display: flex; flex-direction: column; gap: 16rpx; }

.course-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
  background: rgba(14, 165, 233, 0.12);
  border: 2rpx solid transparent;
}

.course-item.is-ongoing {
  background: rgba(16, 185, 129, 0.12);
  border-color: rgba(16, 185, 129, 0.35);
}

.course-main { flex: 1; min-width: 0; }

.course-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.course-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-place {
  font-size: 28rpx;
  color: var(--text-4);
  margin-top: 6rpx;
}

.course-time {
  font-size: 30rpx;
  font-weight: 600;
  color: #38bdf8;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

/* ── 待处理 ───────────────────────────────────── */
.sec-label {
  font-size: 24rpx;
  color: var(--text-4);
  margin-bottom: 12rpx;
}

/* 小程序 WXSS 不支持 :last-child 等结构伪类，
   改用父容器的负下边距抵消最后一项的多余间距。 */
.todo-list-wrap { margin-bottom: -12rpx; }

.todo-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-radius: 16rpx;
  background: var(--surface-3);
  border: 2rpx solid var(--border-2);
  padding: 18rpx 22rpx;
  margin-bottom: 12rpx;
}

.checkbox-sm {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 3rpx solid #475569;
  flex-shrink: 0;
}

.todo-icon { flex-shrink: 0; display: flex; align-items: center; }

.todo-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.muted { color: var(--text-4); }

/* ── 时间轴 ───────────────────────────────────── */
/* 时间轴：同样不用 :last-child，靠容器负边距收尾 */









.full { width: 100%; box-sizing: border-box; }
/* ── 置顶卡片就地编辑（桌面版 Dashboard.tsx:219-257）──
   桌面版靠 hover 出铅笔；手机没有 hover，改成点卡片进入编辑态。
   编辑态下卡片里是 名称输入框 + 日期选择 + 保存/取消。 */
.pin-card.is-editing {
  min-width: 240rpx;
  padding: 16rpx 18rpx 14rpx;
  background: rgba(255, 255, 255, 0.18);
  border-color: rgba(255, 255, 255, 0.35);
}

/* 可点区域：覆盖 label/days/unit 三行，不跟右上角的 ✕ 抢点击 */
.pin-tap {
  display: block;
}

.pin-edit-input {
  width: 100%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  padding: 6rpx 10rpx;
  font-size: 24rpx;
  color: #fff;
  text-align: center;
}

.pin-edit-ph {
  color: rgba(255, 255, 255, 0.5);
}

.pin-edit-date {
  margin-top: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  padding: 6rpx 10rpx;
  font-size: 24rpx;
  color: #fff;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.pin-edit-actions {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.pin-edit-btn {
  flex: 1;
  border-radius: 8rpx;
  padding: 6rpx 0;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.12);
}

.pin-edit-btn.is-save {
  color: #fff;
  background: rgba(255, 255, 255, 0.28);
}
/* ══════════════════════════════════════════════════════════════
   v1.2.0 · AI 对话区
   ─────────────────────────────────────────────────────────────
   首页第一屏。设计意图见 utils/insight.js 顶部注释。
   样式全部走本项目 token，深浅两套主题自动跟随。
   ══════════════════════════════════════════════════════════════ */

.ai-card {
  background: var(--surface-1);
  border: 2rpx solid var(--border-1);
  border-radius: 24rpx;
  padding: 30rpx 30rpx 26rpx;
  /* 顶部一道极淡的高光，和普通卡片区分开 —— 这是「对话」不是「数据区」 */
  background-image: var(--panel-head);
}

.ai-greet {
  font-size: 28rpx;
  color: var(--text-4);
  letter-spacing: 0.5rpx;
  margin-bottom: 14rpx;
}

.ai-q-title {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--text-1);
  line-height: 1.35;
  letter-spacing: -0.3rpx;
}

.ai-q-body {
  font-size: 28rpx;
  color: var(--text-3);
  line-height: 1.6;
  margin-top: 12rpx;
}

.ai-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 26rpx;
}

.ai-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 78rpx;
  padding: 0 34rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.ai-btn-primary {
  background: #047857;
  color: #fff;
}

.ai-btn-ghost {
  background: var(--surface-3);
  color: var(--text-2);
  border: 2rpx solid var(--border-2);
}

/* 选择题：一行一个，点击区域大，不用瞄准确 */
.ai-choice {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--surface-3);
  border: 2rpx solid var(--border-2);
  color: var(--text-2);
  font-size: 30rpx;
  box-sizing: border-box;
}

.ai-q-done .ai-q-title {
  color: var(--text-2);
  font-size: 30rpx;
}

/* ── 洞察列表 ── */
.ai-insights {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ai-insight {
  display: flex;
  gap: 18rpx;
  background: var(--surface-1);
  border: 2rpx solid var(--border-1);
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
}

/* 左侧小圆点，用色相区分语气：amber=需注意 / emerald=好消息 / sky=一般 */
.ai-insight-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.ai-insight-main {
  flex: 1;
  min-width: 0;
}

.ai-insight-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.45;
}

.ai-insight-body {
  font-size: 28rpx;
  color: var(--text-3);
  line-height: 1.6;
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
}

/* ── 浅色主题下的倒计时卡片 ───────────────────────────────
   这张卡原本整套用「白色半透明」画：底是 rgba(255,255,255,0.12)，
   字是 rgba(255,255,255,0.5~0.92)。这些值只在深色底上成立。
   浅色主题下卡片底变成白卡，白底 + 白字 = 一片空白，选择器浮层
   也变成一块灰扑扑的方块（截图里看到的就是这个）。

   这里给出一组浅色覆盖：底改成浅灰、字改成深灰、描边改成实色。
   统一集中在文件末尾，是因为 .page-wrap.theme-light 是外层选择器，
   特异性比单个类名高，放在任何位置都能生效，集中在末尾更好维护。 */
.page-wrap.theme-light .pin-card {
  background: #f1f5f9;
  border-color: #e2e8f0;
}

.page-wrap.theme-light .pin-card.is-editing {
  background: #e2e8f0;
  border-color: #cbd5e1;
}

.page-wrap.theme-light .pin-x,
.page-wrap.theme-light .pin-picker-head,
.page-wrap.theme-light .pin-picker-empty,
.page-wrap.theme-light .pin-picker-meta,
.page-wrap.theme-light .pin-edit-ph {
  color: #64748b;
}

.page-wrap.theme-light .pin-x {
  background: rgba(15, 23, 42, 0.06);
}

.page-wrap.theme-light .pin-add-plus,
.page-wrap.theme-light .pin-add-text {
  color: #334155;
}

.page-wrap.theme-light .pin-add-hint {
  color: #64748b;
}

.page-wrap.theme-light .pin-picker {
  background: #f8fafc;
  border-color: #e2e8f0;
}

.page-wrap.theme-light .pin-picker-title {
  color: #0f172a;
}

.page-wrap.theme-light .pin-edit-btn {
  color: #334155;
  background: rgba(15, 23, 42, 0.06);
}

/* 倒计时卡片正文：这三处是深色主题下「白字压深色玻璃」的写法，
   浅色主题要整体翻成深灰，否则看不到。 */
.page-wrap.theme-light .pin-label {
  color: #475569;
}

.page-wrap.theme-light .pin-days {
  color: #0f172a;
}

.page-wrap.theme-light .pin-unit {
  color: #64748b;
}

/* 就地编辑用的输入框和日期按钮，底也要从「白色半透明」翻成浅灰实底 */
.page-wrap.theme-light .pin-edit-input,
.page-wrap.theme-light .pin-edit-date {
  background: rgba(15, 23, 42, 0.06);
  color: #0f172a;
}
