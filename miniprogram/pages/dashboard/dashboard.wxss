/* 总览页样式。app.wxss 是全局样式，本就自动生效，无需 @import。 */

/* ── 欢迎条 ───────────────────────────────────── */
.hero {
  border-radius: 28rpx;
  padding: 36rpx 32rpx 30rpx;
  background: linear-gradient(135deg, #059669 0%, #047857 55%, #0f766e 100%);
  box-shadow: 0 16rpx 40rpx -14rpx rgba(4, 120, 87, 0.5);
  margin-bottom: 24rpx;
}

.hero-week {
  font-size: 23rpx;
  font-weight: 500;
  color: rgba(209, 250, 229, 0.92);
}

.hero-date {
  font-size: 46rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 10rpx;
  letter-spacing: -0.5rpx;
}

.hero-wd {
  font-size: 30rpx;
  font-weight: 500;
  color: rgba(209, 250, 229, 0.75);
  margin-left: 12rpx;
}

.hero-greet {
  font-size: 25rpx;
  color: rgba(209, 250, 229, 0.85);
  margin-top: 10rpx;
}

/* ── 钉住的倒计时 ─────────────────────────────── */
.pin-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 26rpx;
}

.pin-card {
  min-width: 168rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  text-align: center;
}

.pin-card.is-compact {
  min-width: 130rpx;
  padding: 14rpx 16rpx;
}

.pin-label {
  font-size: 21rpx;
  color: rgba(209, 250, 229, 0.9);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 220rpx;
}

.pin-days {
  font-size: 54rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.15;
}

.pin-card.is-compact .pin-days { font-size: 42rpx; }

.pin-unit {
  font-size: 20rpx;
  color: rgba(209, 250, 229, 0.9);
}

.pin-add {
  min-width: 260rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.32);
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.pin-add-plus { font-size: 34rpx; color: rgba(255, 255, 255, 0.8); }
.pin-add-text { font-size: 20rpx; color: rgba(255, 255, 255, 0.75); }

/* ── 时间轴 ───────────────────────────────────── */
/* 时间轴：小程序不支持 :last-child，靠容器负下边距抵消末项间距 */
.tl { position: relative; margin-bottom: -18rpx; }

.tl-item {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.tl-time {
  width: 92rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-4);
  padding-top: 16rpx;
  font-variant-numeric: tabular-nums;
}

.tl-body {
  flex: 1;
  min-width: 0;
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--border-1);
}

.tl-body.is-ongoing {
  background: rgba(16, 185, 129, 0.1);
  border-color: rgba(16, 185, 129, 0.3);
}

.tl-body.is-done { opacity: 0.6; }

.tl-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tl-title {
  flex: 1;
  font-size: 27rpx;
  font-weight: 500;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tl-min { font-size: 20rpx; color: var(--text-4); }

.tl-sub {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 6rpx;
}

/* ── 迷你列表 ─────────────────────────────────── */
.mini-list { display: flex; flex-direction: column; gap: 12rpx; }

.mini-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--border-1);
  padding: 18rpx 22rpx;
}

.mini-row.is-block { display: block; }

.mini-row-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.mini-title {
  flex: 1;
  font-size: 25rpx;
  font-weight: 500;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-text {
  flex: 1;
  font-size: 25rpx;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-sub {
  font-size: 21rpx;
  color: var(--text-4);
  margin-top: 8rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-rose    { background: #f43f5e; }
.dot-emerald { background: #10b981; }
.dot-slate   { background: #64748b; }

/* ── 通用 ─────────────────────────────────────── */
.head-link {
  font-size: 23rpx;
  font-weight: 500;
  color: #34d399;
}

.two-col { display: flex; gap: 24rpx; }
.two-col > view { flex: 1; }

.big-num {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
  line-height: 1.25;
}

.big-sub {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-4);
}

.bar {
  width: 100%;
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--border-1);
  overflow: hidden;
  margin-top: 18rpx;
}

.bar-fill { height: 100%; border-radius: 999rpx; }
.bar-emerald { background: linear-gradient(90deg, #10b981, #2dd4bf); }
.bar-amber   { background: linear-gradient(90deg, #f59e0b, #fb923c); }

.alert {
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  font-size: 25rpx;
  margin-top: 24rpx;
}

.alert-rose {
  background: rgba(244, 63, 94, 0.1);
  border: 2rpx solid rgba(244, 63, 94, 0.3);
  color: #fda4af;
}

.bold { font-weight: 700; }

/* ── 功能入口网格 ─────────────────────────────── */
/* 用 grid 而非 flex-wrap：4 列在窄屏也稳，不会被 gap 挤溢 */
.nav-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 6rpx 16rpx;
  border-radius: 18rpx;
  border: 2rpx solid var(--border-2);
  background: var(--surface-3);
  min-width: 0;
}

.nav-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.nav-name {
  font-size: 21rpx;
  font-weight: 500;
  color: var(--text-2);
  text-align: center;
  line-height: 1.3;
}

.nav-sub {
  font-size: 18rpx;
  color: var(--text-4);
  text-align: center;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}