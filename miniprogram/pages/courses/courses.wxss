/* 课表管理页样式 */

/* ── 课程列表 ─────────────────────────────────── */
.course-list { margin-top: 4rpx; }

.course-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: var(--surface-3);
  border: 2rpx solid var(--border-2);
  margin-bottom: 14rpx;
}

.course-main { flex: 1; min-width: 0; }

.course-name-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.course-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 380rpx;
}

.course-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 23rpx;
  color: var(--text-3);
  margin-bottom: 8rpx;
}

.course-day {
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--surface-4);
  color: var(--text-2);
  font-size: 21rpx;
}

.course-time { color: var(--text-2); font-variant-numeric: tabular-nums; }
.course-weeks { color: var(--text-4); font-size: 22rpx; }

.course-sub {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 16rpx;
  font-size: 22rpx;
  color: var(--text-4);
}

.course-sub .ml { margin-left: 0; }

.course-ops {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}

.icon-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  background: var(--surface-4);
  border: 2rpx solid var(--border-2);
}

/* ── 周课表网格 ───────────────────────────────── */
.week-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.week-col {
  border-radius: 20rpx;
  border: 2rpx solid var(--border-2);
  background: var(--surface-3);
  padding: 18rpx 20rpx;
}

.week-col.is-today {
  background: rgba(16, 185, 129, 0.1);
  border-color: rgba(16, 185, 129, 0.38);
}

.week-col-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.week-day {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
}

.week-count {
  margin-left: auto;
  font-size: 21rpx;
  color: var(--text-4);
}

.week-none {
  font-size: 22rpx;
  color: var(--text-4);
  padding: 6rpx 0;
}

.week-item {
  background: var(--surface-1);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 10rpx;
}

.week-item-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14rpx;
}

.week-item-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.week-item-time {
  font-size: 21rpx;
  color: #38bdf8;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.week-item-place {
  font-size: 21rpx;
  color: var(--text-4);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grid-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-4);
  text-align: center;
}
