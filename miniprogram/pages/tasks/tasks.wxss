/* 待办 · 作业（合并页）样式。
   两段内容分别来自原 todos.wxss 和 assignments.wxss；
   共用的类（alert / bold / del-btn / form-row / form-col / picker-input / tick）
   只保留 todos 那份，避免同名规则互相覆盖。 */

/* ── 顶部分段切换 ── */
.seg-bar {
  display: flex;
  gap: 12rpx;
  padding: 10rpx;
  border-radius: 22rpx;
  background: var(--chip-bg);
  border: 2rpx solid var(--border);
}
.seg-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  padding: 18rpx 10rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--text-3);
  transition: background 0.15s, color 0.15s;
}
.seg-item.is-active {
  background: rgba(16, 185, 129, 0.16);
  color: #34d399;
  font-weight: 600;
}
.seg-icon { font-size: 26rpx; }
.seg-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.seg-badge {
  min-width: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.22);
  color: var(--text-3);
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}
.seg-item.is-active .seg-badge {
  background: rgba(16, 185, 129, 0.25);
  color: #34d399;
}

/* ── 待办部分（原 todos.wxss） ── */
/* 待办页样式。app.wxss 是全局样式，本就自动生效，无需 @import。 */

.form-row {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
}

.form-col { flex: 1; min-width: 0; }

.picker-input {
  display: flex;
  align-items: center;
  color: var(--text-1);
  font-size: 27rpx;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.quick-label { font-size: 21rpx; color: var(--text-4); }

.quick-pill {
  font-size: 21rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--border-1);
  color: var(--text-3);
}

.quick-clear { font-size: 21rpx; color: #fb7185; margin-left: 8rpx; }

.head-link { font-size: 23rpx; font-weight: 500; color: #34d399; }

/* ── 待办条目 ─────────────────────────────────── */
.todo-list { display: flex; flex-direction: column; gap: 14rpx; }

.todo-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  background: var(--surface-3);
  border: 2rpx solid transparent;
}

.todo-item.is-done {
  background: var(--surface-1);
  opacity: 0.5;
}

.todo-item.is-overdue {
  background: rgba(244, 63, 94, 0.1);
  border-color: rgba(244, 63, 94, 0.3);
}

.tick {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 4rpx solid #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #fff;
  line-height: 1;
  box-sizing: border-box;
}

.tick.is-checked {
  background: #10b981;
  border-color: #10b981;
}

.todo-main { flex: 1; min-width: 0; }

.todo-text {
  font-size: 27rpx;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-text.is-struck { text-decoration: line-through; }

.todo-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.todo-due { font-size: 21rpx; }
.todo-due.is-rose    { color: #fb7185; font-weight: 500; }
.todo-due.is-amber   { color: #fbbf24; font-weight: 500; }
.todo-due.is-slate   { color: var(--text-4); }

.del-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
  opacity: 0.55;
}

.alert {
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  font-size: 25rpx;
}

.alert-amber {
  background: rgba(245, 158, 11, 0.1);
  border: 2rpx solid rgba(245, 158, 11, 0.3);
  color: #fcd34d;
}

.bold { font-weight: 700; }

.footnote {
  font-size: 21rpx;
  color: var(--text-4);
  padding: 8rpx 4rpx;
}


/* ── 作业部分（原 assignments.wxss，已去重） ── */
/* 作业页样式。app.wxss 是全局样式，本就自动生效，无需 @import。 */

.course-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.course-stat {
  box-sizing: border-box;
  border-radius: 18rpx;
  background: var(--surface-3);
  border: 2rpx solid var(--border-2);
  padding: 20rpx 22rpx;
  min-width: 0;
}

.course-stat-name {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-stat-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.course-stat-prog { font-size: 21rpx; color: var(--text-4); }

/* ── 作业条目 ─────────────────────────────────── */
.assign-list { display: flex; flex-direction: column; gap: 14rpx; }

.assign-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  background: var(--surface-3);
  border: 2rpx solid transparent;
}

.assign-item.is-done { background: var(--surface-1); opacity: 0.5; }
.assign-item.is-overdue { background: rgba(244, 63, 94, 0.1); border-color: rgba(244, 63, 94, 0.3); }
.assign-item.is-soon { background: rgba(245, 158, 11, 0.1); border-color: rgba(245, 158, 11, 0.3); }

.assign-main { flex: 1; min-width: 0; }

.assign-title-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.assign-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--text-1);
}

.assign-title.is-struck { text-decoration: line-through; }

.assign-sub {
  font-size: 21rpx;
  color: var(--text-4);
  margin-top: 8rpx;
}

.assign-detail {
  font-size: 21rpx;
  color: var(--text-4);
  margin-top: 6rpx;
}

.alert-rose {
  background: rgba(244, 63, 94, 0.1);
  border: 2rpx solid rgba(244, 63, 94, 0.3);
  color: #fda4af;
}
