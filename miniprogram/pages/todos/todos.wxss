/* 待办页样式。app.wxss 是全局样式，本就自动生效，无需 @import。 */

.form-row {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
}

.form-col { flex: 1; min-width: 0; }

.picker-input {
  display: flex;
  align-items: center;
  color: var(--text-1);
  font-size: 27rpx;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.quick-label { font-size: 21rpx; color: var(--text-4); }

.quick-pill {
  font-size: 21rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--border-1);
  color: var(--text-3);
}

.quick-clear { font-size: 21rpx; color: #fb7185; margin-left: 8rpx; }

.head-link { font-size: 23rpx; font-weight: 500; color: #34d399; }

/* ── 待办条目 ─────────────────────────────────── */
.todo-list { display: flex; flex-direction: column; gap: 14rpx; }

.todo-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  background: var(--surface-3);
  border: 2rpx solid transparent;
}

.todo-item.is-done {
  background: var(--surface-1);
  opacity: 0.5;
}

.todo-item.is-overdue {
  background: rgba(244, 63, 94, 0.1);
  border-color: rgba(244, 63, 94, 0.3);
}

.tick {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 4rpx solid #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #fff;
  line-height: 1;
  box-sizing: border-box;
}

.tick.is-checked {
  background: #10b981;
  border-color: #10b981;
}

.todo-main { flex: 1; min-width: 0; }

.todo-text {
  font-size: 27rpx;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-text.is-struck { text-decoration: line-through; }

.todo-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.todo-due { font-size: 21rpx; }
.todo-due.is-rose    { color: #fb7185; font-weight: 500; }
.todo-due.is-amber   { color: #fbbf24; font-weight: 500; }
.todo-due.is-slate   { color: var(--text-4); }

.del-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
  opacity: 0.55;
}

.alert {
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  font-size: 25rpx;
}

.alert-amber {
  background: rgba(245, 158, 11, 0.1);
  border: 2rpx solid rgba(245, 158, 11, 0.3);
  color: #fcd34d;
}

.bold { font-weight: 700; }

.footnote {
  font-size: 21rpx;
  color: var(--text-4);
  padding: 8rpx 4rpx;
}
