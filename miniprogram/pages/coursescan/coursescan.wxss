/* 课表识别页样式 */

/* ── 提示条 ───────────────────────────────────── */
.notice {
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  border: 2rpx solid transparent;
}

.notice-text { color: inherit; }

/* 解析警告里会带上出错的原句，可能很长且夹着长英文/路径，
   加 word-break 防止把卡片撑破 */
.parse-warn .notice-text {
  display: block;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.notice-ok   { background: rgba(16, 185, 129, 0.12); border-color: rgba(16, 185, 129, 0.35); color: #6ee7b7; }
.notice-err  { background: rgba(244, 63, 94, 0.12);  border-color: rgba(244, 63, 94, 0.35);  color: #fda4af; }
.notice-info { background: rgba(14, 165, 233, 0.12); border-color: rgba(14, 165, 233, 0.35); color: #7dd3fc; }

/* 解析警告可能有多条，叠在一起时留出间距（小程序不支持 :last-child，
   所以统一用 margin-top，靠父级 .stack 的 gap 处理首条） */
.parse-warn { margin-top: 12rpx; }

/* ── 顶部提示粘住视口 ────────────────────────────
   这个页面从粘贴框到导入按钮隔着一整份核对列表，提示跟着滚就白提示了：
   用户在下面点「导入课表」，结果只有页面顶端闪一下，他看不到。
   sticky 只在滚动时贴顶，停在顶部时仍占正常位置，不会挡住第一张卡片。
   只给 msg 那条加（.parse-warn 是卡片内的静态警告，不能一起浮起来）。 */
.notice-float {
  position: sticky;
  top: 0;
  z-index: 60;
  margin-bottom: 16rpx;
  /* 浮起来就必须不透明：.notice-* 的底色都只有 12% 不透明度，
     贴在卡片上方时卡片文字会直接透出来，看着像被压在下面。
     这里改成「页面底色 + 同色薄涂层」两层不透明组合（--surface-0 会随主题切换），
     再给一点投影把它和底下的内容分开。 */
  background-color: var(--surface-0);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.35);
}

.notice-float.notice-ok   { background-image: linear-gradient(rgba(16, 185, 129, 0.16), rgba(16, 185, 129, 0.16)); }
.notice-float.notice-err  { background-image: linear-gradient(rgba(244, 63, 94, 0.16),  rgba(244, 63, 94, 0.16)); }
.notice-float.notice-info { background-image: linear-gradient(rgba(14, 165, 233, 0.16), rgba(14, 165, 233, 0.16)); }

/* ── 导入结果就地确认 ───────────────────────────── */
.import-done {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(16, 185, 129, 0.12);
  border: 2rpx solid rgba(16, 185, 129, 0.35);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.import-done-text {
  font-size: 25rpx;
  line-height: 1.6;
  color: #6ee7b7;
}

/* ── 说明块 ───────────────────────────────────── */
.hint-box {
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.7;
  background: var(--surface-3);
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 20rpx;
}

.prompt-box {
  background: var(--surface-3);
  border: 2rpx solid var(--border-2);
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 20rpx;
  max-height: 620rpx;
  overflow-y: auto;
}

.prompt-text {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-all;
}

/* ── 粘贴区 ───────────────────────────────────── */
.paste-area {
  width: 100%;
  height: 420rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  border: 2rpx solid var(--border-3);
  background: var(--surface-3);
  padding: 20rpx 22rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--text-1);
}

/* ── 周次检测 ─────────────────────────────────── */
.week-detect {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
  background: rgba(14, 165, 233, 0.1);
  border: 2rpx solid rgba(14, 165, 233, 0.32);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 18rpx;
}

.week-detect-text {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: #7dd3fc;
}

/* ── 原始文字 ─────────────────────────────────── */
.raw-box {
  background: var(--surface-3);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 20rpx;
  max-height: 420rpx;
  overflow-y: auto;
}

.raw-line {
  display: block;
  font-size: 21rpx;
  color: var(--text-4);
  line-height: 1.7;
  font-family: monospace;
  word-break: break-all;
}

/* ── 草稿列表 ─────────────────────────────────── */
.draft-list { margin-top: 4rpx; }

.draft-item {
  border-radius: 20rpx;
  border: 2rpx solid var(--border-2);
  background: var(--surface-3);
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
}

.draft-item.is-off { opacity: 0.5; }

.draft-top {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.checkbox.is-on {
  background: #059669;
  border-color: #059669;
}

.draft-day {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-1);
}

.draft-time {
  font-size: 23rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.draft-field {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.draft-label {
  width: 68rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-4);
}

.draft-input {
  flex: 1;
  min-width: 0;
  height: 66rpx;
  border-radius: 14rpx;
  border: 2rpx solid var(--border-3);
  background: var(--surface-1);
  padding: 0 18rpx;
  font-size: 25rpx;
  color: var(--text-1);
  box-sizing: border-box;
}

.draft-raw {
  font-size: 20rpx;
  color: var(--text-4);
  margin-top: 10rpx;
  line-height: 1.6;
  word-break: break-all;
}

/* ── 格式说明 ─────────────────────────────────── */
.fmt-line {
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.9;
}

.mono {
  font-family: monospace;
  font-size: 22rpx;
  color: #38bdf8;
  background: var(--chip-bg);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}
/* ── 识别记录 ─────────────────────────────────────── */
.doc-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--surface-3);
  border: 2rpx solid var(--border-2);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
}

.doc-main {
  flex: 1;
  min-width: 0;
}

.doc-name {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.doc-meta {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-4);
  font-variant-numeric: tabular-nums;
}

/* 删除按钮给足点击面积 */
.doc-del {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #f87171;
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(248, 113, 113, 0.12);
}