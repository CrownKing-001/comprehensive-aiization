/* 体重作息页样式 */

/* ── 概览卡（复用 dashboard 的 stat-grid 结构） ── */
.stat-sub {
  font-size: 20rpx;
  color: var(--text-4);
  margin-top: 8rpx;
  line-height: 1.5;
}

.stat-num-sm {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
}

/* ── 图表 ─────────────────────────────────────── */
.chart-canvas {
  width: 100%;
  height: 280rpx;
}

.chart-note {
  font-size: 21rpx;
  margin-top: 12rpx;
  line-height: 1.6;
}

.chart-note.is-ok { color: #34d399; }
.chart-note.is-warn { color: #fbbf24; }

/* ── 训练打卡 7 格 ───────────────────────────── */
.train-grid {
  display: flex;
  gap: 10rpx;
}

.train-day {
  flex: 1;
  min-width: 0;
  border-radius: 16rpx;
  border: 2rpx solid var(--border-2);
  background: var(--surface-3);
  padding: 14rpx 0 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.train-day.is-today {
  border-color: rgba(16, 185, 129, 0.5);
}

.train-day.is-done {
  background: rgba(16, 185, 129, 0.16);
  border-color: #059669;
}

.train-wd {
  font-size: 19rpx;
  color: var(--text-4);
}

.train-num {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}

.train-mark {
  font-size: 20rpx;
  color: #34d399;
  line-height: 1;
}

.train-plan {
  font-size: 22rpx;
  color: var(--text-4);
  line-height: 1;
}

/* ── 月历打卡 ────────────────────────────────────── */
.cal {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid var(--border);
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

/* 翻月按钮 56rpx 见方，手指点得中 */
.cal-nav {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 14rpx;
  font-size: 32rpx;
  color: var(--text-3);
  background: var(--chip-bg);
  flex-shrink: 0;
}

/* 已经到当月了，下个月按钮变灰（点它也没用） */
.cal-nav.is-off {
  opacity: 0.3;
}

.cal-mid { text-align: center; flex: 1; min-width: 0; }

.cal-month {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
}

.cal-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-4);
}

.cal-streak {
  margin-left: 12rpx;
  color: #34d399;
  font-weight: 600;
}

.cal-week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.cal-wd {
  text-align: center;
  font-size: 20rpx;
  color: var(--text-4);
}

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.cal-cell {
  position: relative;
  height: 68rpx;
  border-radius: 14rpx;
  border: 2rpx solid transparent;
  background: var(--surface-3);
  color: var(--text-3);
  font-size: 23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-variant-numeric: tabular-nums;
}

/* 邻月的日子淡出，但仍然可点 —— 方便补上个月漏打的 */
.cal-cell.is-out { opacity: 0.35; }

.cal-cell.is-future { opacity: 0.2; }

/* 有训练安排但还没打卡：浅底 + 绿边，一眼看出「该练没练」 */
.cal-cell.is-plan {
  background: rgba(16, 185, 129, 0.1);
  border-color: rgba(16, 185, 129, 0.3);
  color: #34d399;
}

.cal-cell.is-done {
  background: #10b981;
  border-color: #10b981;
  color: #fff;
  font-weight: 600;
}

.cal-cell.is-today {
  border-color: rgba(56, 189, 248, 0.6);
}

/* 勾角标：小程序不支持 :last-child 之类的伪类，直接绝对定位 */
.cal-check {
  position: absolute;
  right: 6rpx;
  bottom: 2rpx;
  font-size: 16rpx;
  opacity: 0.85;
}

.cal-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 18rpx;
  font-size: 19rpx;
  color: var(--text-4);
}

.cal-lg {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cal-sw {
  width: 22rpx;
  height: 22rpx;
  border-radius: 6rpx;
  background: var(--surface-3);
  border: 2rpx solid var(--border-2);
}

.cal-sw.is-done {
  background: #10b981;
  border-color: #10b981;
}

.cal-sw.is-plan {
  background: rgba(16, 185, 129, 0.1);
  border-color: rgba(16, 185, 129, 0.3);
}

/* ── 历史行 ───────────────────────────────────── */
.hd-weight,
.hd-sleep,
.hd-steps {
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.hd-weight { color: #34d399; }
.hd-sleep { color: #38bdf8; }
.hd-steps { color: var(--text-4); }

/* ── 弹层 ─────────────────────────────────────── */
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  z-index: 100;
}

.modal-card {
  width: 100%;
  max-width: 620rpx;
  max-height: 80%;
  overflow-y: auto;
  background: var(--surface-1);
  border: 2rpx solid var(--border-2);
  border-radius: 28rpx;
  padding: 34rpx 32rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 26rpx;
}
