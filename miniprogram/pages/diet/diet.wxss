/* 饮食记录页样式 */

/* ── 今日营养双列 ─────────────────────────────── */
.nutri-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.nutri-col {
  flex: 1;
  min-width: 0;
}

.nutri-num {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.nutri-unit {
  font-size: 21rpx;
  font-weight: 500;
  color: var(--text-4);
}

.nutri-label {
  font-size: 22rpx;
  color: var(--text-4);
  margin: 4rpx 0 8rpx;
}

/* ── 餐次分组 ─────────────────────────────────── */
.meal-group {
  margin-top: 22rpx;
  border-top: 2rpx solid var(--border-1);
  padding-top: 18rpx;
}

.meal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.meal-name {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-2);
}

.meal-sum {
  font-size: 21rpx;
  color: var(--text-4);
  font-variant-numeric: tabular-nums;
}

.meal-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: var(--surface-3);
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 10rpx;
}

.meal-item-text {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meal-item-num {
  font-size: 21rpx;
  color: var(--text-4);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

/* ── 已选清单 ─────────────────────────────────── */
.picked-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: rgba(16, 185, 129, 0.08);
  border: 2rpx solid rgba(16, 185, 129, 0.25);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 10rpx;
}

.picked-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qty-group {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: var(--surface-4);
  border: 2rpx solid var(--border-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-2);
}

.qty-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
}

.picked-num {
  font-size: 21rpx;
  color: #34d399;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

/* ── 分隔线 ───────────────────────────────────── */
.divider {
  height: 2rpx;
  background: var(--border-1);
  margin: 26rpx 0 20rpx;
}

/* ── 套餐网格 ─────────────────────────────────── */
.tpl-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.tpl-card {
  border-radius: 18rpx;
  border: 2rpx solid var(--border-2);
  background: var(--surface-3);
  padding: 18rpx 20rpx;
  min-width: 0;
}

/* 自己存的套餐：绿色描边，和内置的区分开（桌面版也是这个区分方式） */
.tpl-card.is-mine {
  border-color: rgba(16, 185, 129, 0.4);
  background: rgba(16, 185, 129, 0.1);
}

.tpl-card.is-mine .tpl-name {
  color: #34d399;
}

/* 「★ 我自己存的」小标题 */
.tpl-sub {
  margin: 24rpx 0 14rpx;
  font-size: 21rpx;
  color: var(--text-4);
}

.tpl-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tpl-sum {
  font-size: 20rpx;
  color: var(--text-4);
  line-height: 1.5;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.tpl-num {
  font-size: 20rpx;
  color: #a78bfa;
  font-variant-numeric: tabular-nums;
}

/* ── 食物库网格 ───────────────────────────────── */
.food-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 4rpx;
}

.food-card {
  border-radius: 16rpx;
  border: 2rpx solid var(--border-2);
  background: var(--surface-3);
  padding: 16rpx 18rpx;
  min-width: 0;
}

.food-name {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-unit {
  font-size: 19rpx;
  color: var(--text-4);
  margin: 6rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-num {
  font-size: 20rpx;
  color: #34d399;
  font-variant-numeric: tabular-nums;
}

/* ── 历史 ─────────────────────────────────────── */
.hist-day {
  border-radius: 18rpx;
  border: 2rpx solid var(--border-2);
  background: var(--surface-3);
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}

.hist-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.hist-date {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
}

.hist-sum {
  font-size: 20rpx;
  color: var(--text-4);
  font-variant-numeric: tabular-nums;
}

.hist-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
}

.hist-meal {
  font-size: 20rpx;
  color: #38bdf8;
  background: rgba(14, 165, 233, 0.12);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}

.hist-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hist-num {
  font-size: 20rpx;
  color: var(--text-4);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

/* ── 弹层 ─────────────────────────────────────── */
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  z-index: 100;
}

.modal-card {
  width: 100%;
  max-width: 620rpx;
  max-height: 80%;
  overflow-y: auto;
  background: var(--surface-1);
  border: 2rpx solid var(--border-2);
  border-radius: 28rpx;
  padding: 34rpx 32rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 26rpx;
}
