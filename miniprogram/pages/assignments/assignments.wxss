/* 作业页样式。app.wxss 是全局样式，本就自动生效，无需 @import。 */

.form-row { display: flex; gap: 18rpx; margin-top: 18rpx; }
.form-col { flex: 1; min-width: 0; }

.picker-input {
  display: flex;
  align-items: center;
  color: var(--text-1);
  font-size: 27rpx;
}

/* ── 按课程统计 ───────────────────────────────── */
.course-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.course-stat {
  box-sizing: border-box;
  border-radius: 18rpx;
  background: var(--surface-3);
  border: 2rpx solid var(--border-2);
  padding: 20rpx 22rpx;
  min-width: 0;
}

.course-stat-name {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-stat-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.course-stat-prog { font-size: 21rpx; color: var(--text-4); }

/* ── 作业条目 ─────────────────────────────────── */
.assign-list { display: flex; flex-direction: column; gap: 14rpx; }

.assign-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  background: var(--surface-3);
  border: 2rpx solid transparent;
}

.assign-item.is-done { background: var(--surface-1); opacity: 0.5; }
.assign-item.is-overdue { background: rgba(244, 63, 94, 0.1); border-color: rgba(244, 63, 94, 0.3); }
.assign-item.is-soon { background: rgba(245, 158, 11, 0.1); border-color: rgba(245, 158, 11, 0.3); }

.tick {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 4rpx solid #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #fff;
  line-height: 1;
  box-sizing: border-box;
  margin-top: 4rpx;
}

.tick.is-checked { background: #10b981; border-color: #10b981; }

.assign-main { flex: 1; min-width: 0; }

.assign-title-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.assign-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--text-1);
}

.assign-title.is-struck { text-decoration: line-through; }

.assign-sub {
  font-size: 21rpx;
  color: var(--text-4);
  margin-top: 8rpx;
}

.assign-detail {
  font-size: 21rpx;
  color: var(--text-4);
  margin-top: 6rpx;
}

.del-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
  opacity: 0.55;
}

.alert {
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  font-size: 25rpx;
}

.alert-rose {
  background: rgba(244, 63, 94, 0.1);
  border: 2rpx solid rgba(244, 63, 94, 0.3);
  color: #fda4af;
}

.bold { font-weight: 700; }
