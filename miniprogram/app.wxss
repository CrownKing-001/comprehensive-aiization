/* 全局样式。移植自桌面版 src/index.css 的语义色变量。
   变量定义在 .page-wrap 上而不是 page 上 —— 每个页面的根节点都带这个类，
   切浅色主题时只需给它加 .theme-light，变量会被所有子元素继承。
   （变量若挂在 page 上，子元素的类名改不动 page 自身。） */

page {
  /* 这里刻意不写 background：page 是根节点，写死颜色就等于把「窗口底色」钉死成
     某一个主题的颜色，切 tab 时新页面会先画一帧这个颜色再画内容 —— 浅色主题下
     就是用户看到的「整屏黑闪一下」。
     底色交给 app.json 的 window.backgroundColor 兜底，运行时由 utils/theme.js
     用 wx.setBackgroundColor 按当前主题覆盖；page 留空即可透出那一层。 */
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  /* .page-wrap 用的是 min-height:100%，需要一个有确定高度的父级才生效；
     内容很短的页面（例如空的待办列表）否则撑不满屏，下方会露出系统底色。
     这里不能写 100vh —— vh 把 tabBar 也算进视口高度，反而会把内容顶出屏幕。 */
  min-height: 100%;
}

/* ── 盒模型：补回全局 border-box ─────────────────────────
   桌面版用 Tailwind，它的 preflight 里有
     *, ::before, ::after { box-sizing: border-box }
   小程序没有这层 reset，view 默认是 content-box —— 于是
   「width: 100% + padding」的元素总宽会多出左右 padding，
   直接撑出容器。实际踩到的：
     待办页的「＋ 添加」按钮（.btn-primary 有 padding: 0 30rpx，
     WXML 里又写死了 width: 100%），整块凸出卡片右边 ~60rpx，
     一直压到屏幕边缘 —— 用户报的「按钮凸出」就是这个。
   WXSS 不支持 * 选择器，所以按元素类型列出来。 */
view,
text,
image,
button,
input,
textarea,
navigator,
form,
label,
scroll-view,
swiper,
swiper-item,
picker,
picker-view,
movable-view,
movable-area,
cover-view,
camera,
video,
canvas {
  box-sizing: border-box;
}

.page-wrap {
  /* ── 深色主题（默认）───────────────────────────── */
  --surface-0: #12161d; /* 应用底色 */
  --surface-1: #1a1f28; /* 卡片 */
  --surface-2: #171c24; /* 卡片次档 */
  --surface-3: #1e242e; /* 内层 / 输入框底 */
  --surface-4: #262d38; /* hover 底 */
  --surface-5: #333c49; /* 更深边框 */
  --border-1: #232a34;
  --border-2: #2b333f;
  --border-3: #333c49;
  --text-1: #e2e8f0; /* 主文字 */
  --text-2: #cbd5e1; /* 正文 */
  --text-3: #94a3b8; /* 次要 */
  --text-4: #64748b; /* 弱化 */
  --hairline: rgba(255, 255, 255, 0.06);
  --chip-bg: rgba(255, 255, 255, 0.06);
  --panel-head: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0));

  /* 布局：容器自带底色。
     注意不用 min-height:100vh —— 小程序的 vh 把 tabBar 也算进视口高度，
     会导致页面底部内容被 tabBar 压住。改用 min-height:100% 让内容自然撑开，
     底部留出安全距离（padding-bottom）。 */
  min-height: 100%;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--surface-0);
  color: var(--text-1);
}

/* ── 浅色主题 ─────────────────────────────────── */
.page-wrap.theme-light {
  --surface-0: #f8fafc;
  --surface-1: #ffffff;
  --surface-2: #f8fafc;
  --surface-3: #f1f5f9;
  --surface-4: #e2e8f0;
  --surface-5: #cbd5e1;
  --border-1: #e2e8f0;
  --border-2: #cbd5e1;
  --border-3: #cbd5e1;
  --text-1: #0f172a;
  --text-2: #1e293b;
  --text-3: #475569;
  --text-4: #64748b;
  --hairline: rgba(15, 23, 42, 0.05);
  --chip-bg: rgba(15, 23, 42, 0.045);
  --panel-head: linear-gradient(180deg, rgba(15, 23, 42, 0.018), rgba(15, 23, 42, 0));
}

/* ── 布局 ─────────────────────────────────────── */
.stack > .card + .card {
  margin-top: 24rpx;
}

/* ── 卡片 ─────────────────────────────────────── */
/* 不用 overflow:hidden —— 卡片里常放横向滚动的统计行或下拉，
   一旦裁剪就表现为「内容被切掉」。圆角改由子元素各自处理。 */
.card {
  background: var(--surface-1);
  border-radius: 28rpx;
  border: 2rpx solid var(--border-1);
}

.card-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 30rpx 20rpx;
  border-bottom: 2rpx solid var(--border-1);
  background-image: var(--panel-head);
}

.card-head-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  letter-spacing: -0.2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 卡头右侧操作区（按钮等） */
.card-head-action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.card-body {
  padding: 26rpx 30rpx;
}

/* 标题左侧的图标底座，用色相区分区块 */
.icon-chip {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
}

.tone-emerald { background: rgba(16, 185, 129, 0.12); color: #34d399; }
.tone-sky     { background: rgba(14, 165, 233, 0.12); color: #38bdf8; }
.tone-amber   { background: rgba(245, 158, 11, 0.12); color: #fbbf24; }
.tone-rose    { background: rgba(244, 63, 94, 0.12);  color: #fb7185; }
.tone-violet  { background: rgba(139, 92, 246, 0.12); color: #a78bfa; }
.tone-slate   { background: var(--chip-bg); color: var(--text-3); }

/* ── 徽标 ─────────────────────────────────────── */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  border-radius: 999rpx;
  padding: 3rpx 14rpx;
  font-size: 20rpx;
  font-weight: 500;
  white-space: nowrap;
}

.chip-slate   { background: var(--chip-bg); color: var(--text-3); }
.chip-emerald { background: rgba(16, 185, 129, 0.15); color: #34d399; }
.chip-amber   { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
.chip-rose    { background: rgba(244, 63, 94, 0.15);  color: #fb7185; }
.chip-sky     { background: rgba(14, 165, 233, 0.15); color: #38bdf8; }
.chip-violet  { background: rgba(139, 92, 246, 0.15); color: #a78bfa; }

/* ── 按钮 ─────────────────────────────────────── */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: #059669;
  color: #fff;
  font-size: 27rpx;
  font-weight: 500;
  padding: 0 30rpx;
  line-height: 1;
  /* 按钮常被写成「内联 width:100%」撑满一行。
     content-box 时总宽会多出左右各 30rpx、直接凸出卡片 ——
     这里显式声明，别再依赖全局 reset。 */
  box-sizing: border-box;
}

.btn-primary.is-disabled { opacity: 0.4; }

/* 小尺寸按钮变体 */
.btn-sm { height: 64rpx; font-size: 24rpx; padding: 0 22rpx; border-radius: 16rpx; box-sizing: border-box; }
.btn-xs { height: 52rpx; font-size: 22rpx; padding: 0 18rpx; border-radius: 14rpx; box-sizing: border-box; }

/* 按钮行：自动换行，避免窄屏挤压 */
.row-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.row-actions.mt { margin-top: 24rpx; margin-bottom: 0; }

.btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 76rpx;
  border-radius: 18rpx;
  border: 2rpx solid var(--border-3);
  background: var(--surface-3);
  color: var(--text-2);
  font-size: 27rpx;
  font-weight: 500;
  padding: 0 30rpx;
  line-height: 1;
  box-sizing: border-box;
}

/* ── 输入 ─────────────────────────────────────── */
.input {
  width: 100%;
  height: 76rpx;
  border-radius: 18rpx;
  border: 2rpx solid var(--border-3);
  background: var(--surface-3);
  padding: 0 22rpx;
  font-size: 27rpx;
  color: var(--text-1);
  box-sizing: border-box;
}

.input-ph { color: #64748b; }

/* ── 表单字段 ─────────────────────────────────── */
.field { margin-bottom: 20rpx; }

/* 两列并排；小程序不支持 subgrid，用 flex + min-width:0 防溢出 */
.field-row {
  display: flex;
  gap: 18rpx;
}

.field-row .field {
  flex: 1;
  min-width: 0;
}

.field-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
  margin-bottom: 8rpx;
}

.field-hint {
  font-size: 21rpx;
  color: var(--text-4);
  margin-top: 8rpx;
}

/* picker 的显示区，外观与 .input 一致 */
.picker {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 18rpx;
  border: 2rpx solid var(--border-3);
  background: var(--surface-3);
  padding: 0 22rpx;
  font-size: 27rpx;
  color: var(--text-1);
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ── 空状态 ───────────────────────────────────── */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 56rpx 0;
  text-align: center;
}

.empty-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: var(--chip-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.empty-title {
  font-size: 27rpx;
  color: var(--text-3);
  font-weight: 500;
}

.empty-desc {
  font-size: 23rpx;
  color: var(--text-4);
  line-height: 1.6;
  max-width: 460rpx;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-4);
  line-height: 1.6;
  max-width: 460rpx;
}

/* ── 过滤胶囊行 ───────────────────────────────── */
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.filter-pill {
  border-radius: 999rpx;
  padding: 9rpx 24rpx;
  font-size: 23rpx;
  font-weight: 500;
  border: 2rpx solid var(--border-2);
  background: var(--surface-3);
  color: var(--text-3);
}

.filter-pill.is-active {
  background: #059669;
  border-color: #059669;
  color: #fff;
}

.filter-count { margin-left: 8rpx; opacity: 0.75; }

/* ── 进度条 ───────────────────────────────────── */
.bar-track {
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--surface-4);
  overflow: hidden;
  margin-top: 12rpx;
}

.bar-track-sm { margin-top: 0; height: 14rpx; }

/* 进度条填充。
   ── 性能：不要用 transition: width ──────────────────────────
   过渡 width 会让每一帧都触发 layout → paint → composite，
   而且进度条在总览/健康/饮食里是成组出现的，一屏十几条同时动，
   低端安卓机上直接掉帧。这是 v1.0.x「动画卡顿」的主因。

   改成 transform: scaleX() —— 只走 composite，不碰 layout。
   WXML 里两条信息都保留：
     width: X%    兜底，环境不支持 CSS 变量时仍能画对
     --bar: 0.xx  给这里做 scaleX 动画
   width 和 scaleX 同时生效会「宽度 × 缩放」算两遍，所以下面用
   @supports 做能力检测：支持时把 width 交给 transform 接管，
   不支持才退回纯 width。 */
.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #059669;
  transform-origin: left center;
  transition: transform 0.25s cubic-bezier(0.22, 0.61, 0.36, 1);
}

@supports (transform: scaleX(var(--bar, 1))) {
  .bar-fill {
    width: 100% !important;
    transform: scaleX(var(--bar, 1));
    will-change: transform;
  }
}

.bar-emerald { background: #10b981; }
.bar-amber   { background: #f59e0b; }
.bar-sky     { background: #0ea5e9; }
.bar-rose    { background: #f43f5e; }
.bar-violet  { background: #8b5cf6; }

/* ── 大数字统计 ───────────────────────────────── */
.big-stat {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.big-num {
  font-size: 66rpx;
  font-weight: 800;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}

.big-unit {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-4);
}

.big-side {
  font-size: 24rpx;
  color: var(--text-3);
}

.big-pct {
  font-size: 32rpx;
  font-weight: 700;
  color: #34d399;
}

.big-pct-unit { font-size: 22rpx; color: var(--text-4); }

/* ── 胶囊行 ───────────────────────────────────── */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

/* ── 说明条目 ─────────────────────────────────── */
.bullet {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.bullet-dot {
  color: #10b981;
  font-size: 26rpx;
  line-height: 1.5;
  flex-shrink: 0;
}

.bullet-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.bullet-note {
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.8;
}

.tip-box {
  margin-top: 18rpx;
  border-radius: 16rpx;
  background: rgba(16, 185, 129, 0.1);
  border: 2rpx solid rgba(16, 185, 129, 0.28);
  padding: 18rpx 22rpx;
}

.tip-text {
  font-size: 22rpx;
  color: #6ee7b7;
  line-height: 1.7;
}

.inline-hint {
  font-size: 23rpx;
  color: var(--text-4);
  line-height: 1.7;
}

.tiny-note {
  font-size: 21rpx;
  color: var(--text-4);
  line-height: 1.7;
  margin-top: 14rpx;
}

.tiny-note.mt { margin-top: 18rpx; }

/* ── 通用记录列表 ─────────────────────────────── */
.log-list { margin-top: 4rpx; }

.log-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--surface-3);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 12rpx;
}

.log-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #f59e0b;
  flex-shrink: 0;
}

.log-dot.is-primary { background: #10b981; }

.log-date {
  font-size: 23rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.log-type {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.btn-mini {
  width: 52rpx;
  height: 52rpx;
  font-size: 22rpx;
  border-radius: 12rpx;
}

/* ── 每周分布 ─────────────────────────────────── */
.week-bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.week-bar-label {
  width: 110rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.week-bar-label.is-current {
  color: #34d399;
  font-weight: 600;
}

.week-bar-row .bar-track { flex: 1; min-width: 0; }

.week-bar-count {
  width: 80rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 21rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

/* 强调色幽灵按钮 */
.btn-ghost.btn-emerald {
  border-color: rgba(16, 185, 129, 0.4);
  color: #6ee7b7;
  background: rgba(16, 185, 129, 0.1);
}

.btn-ghost.is-disabled { opacity: 0.4; }

/* ── 指标卡网格（总览 / 体重作息共用） ─────────── */
/* 用 grid 而不是 flex-wrap + calc：小程序里 flex 的百分比宽度
   在 gap 参与计算时容易溢出或被挤压，grid 更稳。 */
.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  box-sizing: border-box;
  background: var(--surface-1);
  border: 2rpx solid var(--border-1);
  border-radius: 24rpx;
  padding: 24rpx 24rpx 22rpx;
  min-width: 0; /* 允许内部文字省略号生效，避免撑破格子 */
}

.stat-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.stat-label {
  flex: 1;
  font-size: 22rpx;
  color: var(--text-4);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-value {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 16rpx;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-1);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.stat-unit { font-size: 22rpx; color: var(--text-4); }

.stat-card .chip { margin-top: 16rpx; }

/* ── 勾选框（多个页面共用） ───────────────────── */
.checkbox {
  width: 42rpx;
  height: 42rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--border-3);
  background: var(--surface-1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
  flex-shrink: 0;
}

.checkbox.is-on {
  background: #059669;
  border-color: #059669;
}

/* ── 开关行（标签 + switch） ──────────────────── */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0 20rpx;
}

.switch-row:last-of-type { padding-bottom: 0; }

.switch-label {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--text-3);
}

/* ── 信息提示条 ───────────────────────────────── */
.msg-box {
  background: rgba(14, 165, 233, 0.1);
  border: 2rpx solid rgba(14, 165, 233, 0.3);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 23rpx;
  color: #7dd3fc;
  line-height: 1.7;
  margin-bottom: 18rpx;
}

/* ── 小图标按钮（列表行内的编辑 / 删除） ──────── */
/* 之前只有 .icon-chip（比这个大一圈，带浅色底），
   行内用的 .icon-btn 一直没定义，导致 emoji 失去尺寸和间距、挤在一起。 */
.icon-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  line-height: 1;
  flex-shrink: 0;
  background: var(--chip-bg);
  border: 2rpx solid var(--border-2);
}

/* 需要强调的（删除等）用 tone-* 上色，尺寸不变 */
.icon-btn.tone-rose {
  background: rgba(244, 63, 94, 0.14);
  border-color: rgba(244, 63, 94, 0.3);
}

.icon-btn.tone-emerald {
  background: rgba(16, 185, 129, 0.14);
  border-color: rgba(16, 185, 129, 0.3);
}

/* 更小的变体：和历史行、清单行一起用 */
.icon-btn.btn-mini {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

/* ── 行内强调文字（分析 / 设置共用） ───────────── */
.hl {
  color: #34d399;
  font-weight: 600;
}
/* ══════════════════════════════════════════════════════════════
   v1.1.0 · 结构规范（对齐 WeUI 的布局语言，不引 WeUI 包）
   ─────────────────────────────────────────────────────────────
   为什么不上 WeUI 组件包：
   本项目已经有一套调好的双主题 token（--surface-* / --text-*），
   WeUI 自带的浅色+微信绿会把它们顶掉，等于推翻 96KB 现成样式，
   体积还要再多 ~100KB。这里只借 WeUI 三个真正有用的结构约定：
     1. cell 列表：发丝线分隔 + 统一高度节奏
     2. 8rpx 基准间距梯度
     3. 按压态反馈（weui-active 的等价物）
   样式全部映射到本项目 token，深色/浅色两套主题自动跟随。
   ══════════════════════════════════════════════════════════════ */

/* ── 间距梯度（8rpx 基准，对齐 WeUI 的 16px 栅格） ── */
.gap-1 { gap: 8rpx; }
.gap-2 { gap: 16rpx; }
.gap-3 { gap: 24rpx; }

/* ── cell 列表：WeUI weui-cells 的等价实现 ──────────
   用例：设置项、历史记录、清单。比 log-row 更适合「逐行读」的内容：
   相邻行之间用发丝线，而不是每行一个独立方块 —— 视觉噪音更小。
   注意用 :first-child/:last-child 去掉首尾的线，避免和卡片边缘重叠。 */
.cells {
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--surface-2);
  border: 2rpx solid var(--border-1);
}

.cell {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 22rpx 26rpx;
  background: var(--surface-1);
  position: relative;
}

/* 分隔线用伪元素，避免 border 影响高度计算 */
.cell + .cell::before {
  content: '';
  position: absolute;
  left: 26rpx;
  right: 0;
  top: 0;
  height: 2rpx;
  background: var(--border-1);
  transform: scaleY(0.5);
  transform-origin: top;
}

.cell-main { flex: 1; min-width: 0; }

.cell-title {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-desc {
  font-size: 23rpx;
  color: var(--text-4);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-extra {
  flex-shrink: 0;
  font-size: 25rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

/* 右侧箭头：用 CSS 画的 chevron，不依赖字体图标 */
.cell-arrow { position: relative; padding-right: 26rpx; }
.cell-arrow::after {
  content: '';
  position: absolute;
  right: 6rpx;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  margin-top: -6rpx;
  border-right: 3rpx solid var(--text-4);
  border-bottom: 3rpx solid var(--text-4);
  transform: rotate(-45deg);
}

/* ── 按压态（WeUI weui-active 的等价物） ────────────
   统一给可点击元素加 class="tap"，只改 opacity/transform，
   不触发 layout。 */
.tap {
  transition: opacity 0.12s ease, transform 0.12s ease;
}

.tap-active,
.tap:active {
  opacity: 0.72;
  transform: scale(0.985);
}

/* filter-pill 补按压态（原来只有选中态） */
.filter-pill.tap:active {
  transform: scale(0.96);
}

/* ══════════════════════════════════════════════════════════════
   v1.1.0 · 动效
   ─────────────────────────────────────────────────────────────
   ⚠ 性能红线 —— 只允许过渡这两个属性：
       transform / opacity
   因为它们只走 composite 阶段，GPU 直接合成。
   以下属性一律禁止用于 transition（会导致逐帧 layout/paint，
   在低端安卓上表现为掉帧、滚动发涩）：
       width  height  top  left  right  bottom
       margin  padding  border-width  font-size
       box-shadow（大面积阴影尤其致命）
   新增动画前先确认落在允许清单里。
   ══════════════════════════════════════════════════════════════ */

/* 卡片入场：淡入 + 轻微上浮。
   一次性动画（forwards），不会在滚动时反复触发。 */
@keyframes rise-in {
  from { opacity: 0; transform: translate3d(0, 16rpx, 0); }
  to   { opacity: 1; transform: translate3d(0, 0, 0); }
}

.rise-in {
  animation: rise-in 0.28s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  will-change: transform, opacity;
}

/* 逐条延迟：让同一组卡片有先后，而不是同时出现。
   只给前 6 条不同延迟 —— 再多用户也感知不到，还白占内存。 */
.rise-in.d1 { animation-delay: 0.03s; }
.rise-in.d2 { animation-delay: 0.06s; }
.rise-in.d3 { animation-delay: 0.09s; }
.rise-in.d4 { animation-delay: 0.12s; }
.rise-in.d5 { animation-delay: 0.15s; }
.rise-in.d6 { animation-delay: 0.18s; }

/* 动画结束后释放合成层，避免长期占用显存 */
.rise-in {
  animation-fill-mode: both;
}
.rise-in.done {
  will-change: auto;
  animation: none;
  opacity: 1;
  transform: none;
}

/* 数字滚动式的轻微上浮（大数字统计用） */
@keyframes num-pop {
  from { opacity: 0; transform: translate3d(0, 10rpx, 0); }
  to   { opacity: 1; transform: translate3d(0, 0, 0); }
}

.num-pop {
  animation: num-pop 0.32s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

/* 分段切换 / tab 切换的滑块：用 transform 位移 */
@keyframes fade-slide {
  from { opacity: 0; transform: translate3d(12rpx, 0, 0); }
  to   { opacity: 1; transform: translate3d(0, 0, 0); }
}

.seg-item.is-active .seg-label,
.seg-item.is-active .seg-icon {
  animation: fade-slide 0.22s cubic-bezier(0.22, 0.61, 0.36, 1);
}

/* ── 无障碍：用户开了「减弱动态效果」时全部关掉 ──
   这是系统级设置，尊重它比“好看”重要。 */
@media (prefers-reduced-motion: reduce) {
  .rise-in,
  .rise-in.d1, .rise-in.d2, .rise-in.d3,
  .rise-in.d4, .rise-in.d5, .rise-in.d6,
  .num-pop,
  .bar-fill,
  .seg-item.is-active .seg-label,
  .seg-item.is-active .seg-icon {
    animation: none !important;
    transition: none !important;
    transform: none;
    opacity: 1;
  }
}
