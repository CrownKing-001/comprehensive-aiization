/* 全局样式。移植自桌面版 src/index.css 的语义色变量。
   变量定义在 .page-wrap 上而不是 page 上 —— 每个页面的根节点都带这个类，
   切浅色主题时只需给它加 .theme-light，变量会被所有子元素继承。
   （变量若挂在 page 上，子元素的类名改不动 page 自身。） */

page {
  /* 这里刻意不写 background：page 是根节点，写死颜色就等于把「窗口底色」钉死成
     某一个主题的颜色，切 tab 时新页面会先画一帧这个颜色再画内容 —— 浅色主题下
     就是用户看到的「整屏黑闪一下」。
     底色交给 app.json 的 window.backgroundColor 兜底，运行时由 utils/theme.js
     用 wx.setBackgroundColor 按当前主题覆盖；page 留空即可透出那一层。 */
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
  /* .page-wrap 用的是 min-height:100%，需要一个有确定高度的父级才生效；
     内容很短的页面（例如空的待办列表）否则撑不满屏，下方会露出系统底色。
     这里不能写 100vh —— vh 把 tabBar 也算进视口高度，反而会把内容顶出屏幕。 */
  min-height: 100%;
}

/* ── 盒模型：补回全局 border-box ─────────────────────────
   桌面版用 Tailwind，它的 preflight 里有
     *, ::before, ::after { box-sizing: border-box }
   小程序没有这层 reset，view 默认是 content-box —— 于是
   「width: 100% + padding」的元素总宽会多出左右 padding，
   直接撑出容器。实际踩到的：
     待办页的「＋ 添加」按钮（.btn-primary 有 padding: 0 30rpx，
     WXML 里又写死了 width: 100%），整块凸出卡片右边 ~60rpx，
     一直压到屏幕边缘 —— 用户报的「按钮凸出」就是这个。
   WXSS 不支持 * 选择器，所以按元素类型列出来。 */
view,
text,
image,
button,
input,
textarea,
navigator,
form,
label,
scroll-view,
swiper,
swiper-item,
picker,
picker-view,
movable-view,
movable-area,
cover-view,
camera,
video,
canvas {
  box-sizing: border-box;
}

.page-wrap {
  /* ── 深色主题（默认）───────────────────────────── */
  --surface-0: #12161d; /* 应用底色 */
  --surface-1: #1a1f28; /* 卡片 */
  --surface-2: #171c24; /* 卡片次档 */
  --surface-3: #1e242e; /* 内层 / 输入框底 */
  --surface-4: #262d38; /* hover 底 */
  --surface-5: #333c49; /* 更深边框 */
  --border-1: #232a34;
  --border-2: #2b333f;
  --border-3: #333c49;
  --text-1: #e2e8f0; /* 主文字 */
  --text-2: #cbd5e1; /* 正文 */
  --text-3: #94a3b8; /* 次要 */
  /* 弱化。原来是 #64748b，在卡片底 #1a1f28 上只有 3.47:1，
     不到 WCAG AA 的 4.5:1。现在 5.24:1（页面底 5.75:1），
     仍然是四档里最弱的一档，但看得清了。 */
  --text-4: #8592a6;

  /* ── 字号五档（微信设计指南 5.1：22 / 17 / 15 / 14 / 12 pt）──
     750rpx 设计稿下 1pt = 2rpx，所以五档就是下面这五个值。
     ⚠️ 全站只允许用这五档，不要再写 21rpx / 23rpx / 27rpx 这种
     「看起来差不多」的中间值 —— 它们正是之前 24 种字号并存的来源。 */
  --fs-xl: 44rpx; /* 22pt 大号标题、核心数字 */
  --fs-lg: 34rpx; /* 17pt 页面标题、卡片主数字 */
  --fs-md: 30rpx; /* 15pt 卡片标题、按钮正文 */
  --fs-sm: 28rpx; /* 14pt 正文主力 */
  --fs-xs: 24rpx; /* 12pt 辅助说明、标签、脚注 */
  --hairline: rgba(255, 255, 255, 0.06);
  --chip-bg: rgba(255, 255, 255, 0.06);
  --panel-head: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0));

  /* 欢迎条：深色主题下用比卡片亮一档的实底，不用渐变 */
  --hero-bg: #1f2632;
  --hero-border: #2b333f;
  --hero-text-strong: #f1f5f9; /* 日期：主信息 */
  --hero-text-body: #dbe4ee; /* 问候语 */
  --hero-text-weak: #aab8c9; /* 「第 N 教学周」：辅助 */

  /* 禁用态：不靠整体 opacity，改为专用色。
     原来 .is-disabled 用 opacity: 0.4，文字和底一起变淡，
     浅色主题下只有 1.83:1、深色 2.54:1 —— 按钮像消失了。
     现在底用 surface-3、字用 text-3，两层都保持可读（见 check-contrast.js）。 */
  --disabled-bg: #1e242e;
  --disabled-text: #94a3b8;
  --disabled-border: #2b333f;

  /* 布局：容器自带底色。
     注意不用 min-height:100vh —— 小程序的 vh 把 tabBar 也算进视口高度，
     会导致页面底部内容被 tabBar 压住。改用 min-height:100% 让内容自然撑开，
     底部留出安全距离（padding-bottom）。 */
  min-height: 100%;
  box-sizing: border-box;
  padding: 20rpx 20rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--surface-0);
  color: var(--text-1);
}

/* ── 浅色主题 ─────────────────────────────────── */
.page-wrap.theme-light {
  --surface-0: #f8fafc;
  --surface-1: #ffffff;
  --surface-2: #f8fafc;
  --surface-3: #f1f5f9;
  --surface-4: #e2e8f0;
  --surface-5: #cbd5e1;
  --border-1: #e2e8f0;
  --border-2: #cbd5e1;
  --border-3: #cbd5e1;
  --text-1: #0f172a;
  --text-2: #1e293b;
  --text-3: #475569;
  --text-4: #64748b; /* 白底 4.76:1，已达 AA，无需调整 */
  --hairline: rgba(15, 23, 42, 0.05);
  --chip-bg: rgba(15, 23, 42, 0.045);
  --panel-head: linear-gradient(180deg, rgba(15, 23, 42, 0.018), rgba(15, 23, 42, 0));

  /* 欢迎条：浅色主题下用极浅的绿灰底，靠描边定边界。
     文字必须转成深色 —— 深色主题的那套浅绿白字压在这个底上会完全看不见。 */
  --hero-bg: #f0fdf4;
  --hero-border: #d1fae5;
  --hero-text-strong: #0f172a;
  --hero-text-body: #1e293b;
  --hero-text-weak: #475569;

  /* 禁用态：浅色下用浅灰底 + 深一档的灰字（#5b6779 在 #f1f5f9 上是 5.03:1） */
  --disabled-bg: #f1f5f9;
  --disabled-text: #5b6779;
  --disabled-border: #e2e8f0;
}

/* ── 布局 ─────────────────────────────────────── */
/* 卡片之间的间距用 20rpx（=10px）而不是 24rpx：
   深色底上相邻卡片靠 1rpx 描边就已经能分开，间距再大就会让一屏装不满内容、
   显得松散。20rpx 在 375pt 宽屏上是 10px，视觉上刚好留出呼吸位。 */
.stack > .card + .card {
  margin-top: 20rpx;
}

/* ── 卡片 ─────────────────────────────────────── */
/* 不用 overflow:hidden —— 卡片里常放横向滚动的统计行或下拉，
   一旦裁剪就表现为「内容被切掉」。圆角改由子元素各自处理。 */
.card {
  background: var(--surface-1);
  border-radius: 20rpx;
  /* 1rpx 而不是 2rpx：深色底上 2rpx 的边框会形成一圈明显的「描边感」，
     卡片看起来像贴纸。极细描边只负责在相近底色之间划出边界。 */
  border: 1rpx solid var(--border-1);
}

.card-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx 26rpx 18rpx;
  border-bottom: 1rpx solid var(--border-1);
  background-image: var(--panel-head);
}

.card-head-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  letter-spacing: -0.2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 卡头右侧操作区（按钮等） */
.card-head-action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.card-body {
  padding: 24rpx 26rpx;
}

/* 标题左侧的图标底座，用色相区分区块。
   ── 2026-10-30 重构 ────────────────────────────────────────────
   原来这里是「放 emoji 的定高盒子」：盒 52rpx（=26px），而彩色 emoji 按
   1em×1.17 绘制、基线由系统字体决定，字形高度经常超过盒子 → 上下溢出，
   压到右侧标题上。这就是用户报的「UI 重叠」。

   现在盒子只负责**背景与居中**，字形由里面的 <ui-icon>（WeUI SVG）
   按 px 精确控制，物理上不可能再溢出。同时把盒子加到 56rpx（=28px），
   让 MD 档 20px 图标四周留 4px 呼吸位。 */
.icon-chip {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  /* 兜底：万一又有人在这里塞 emoji，行高也不会把盒子撑开 */
  line-height: 1;
  overflow: hidden;
}

.tone-emerald { background: rgba(16, 185, 129, 0.12); color: #34d399; }
.tone-sky     { background: rgba(14, 165, 233, 0.12); color: #38bdf8; }
.tone-amber   { background: rgba(245, 158, 11, 0.12); color: #fbbf24; }
.tone-rose    { background: rgba(244, 63, 94, 0.12);  color: #fb7185; }
.tone-violet  { background: rgba(139, 92, 246, 0.12); color: #a78bfa; }
.tone-slate   { background: var(--chip-bg); color: var(--text-3); }

/* ── 徽标 ─────────────────────────────────────── */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  border-radius: 999rpx;
  padding: 3rpx 14rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}

.chip-slate   { background: var(--chip-bg); color: var(--text-3); }
.chip-emerald { background: rgba(16, 185, 129, 0.15); color: #34d399; }
.chip-amber   { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
.chip-rose    { background: rgba(244, 63, 94, 0.15);  color: #fb7185; }
.chip-sky     { background: rgba(14, 165, 233, 0.15); color: #38bdf8; }
.chip-violet  { background: rgba(139, 92, 246, 0.15); color: #a78bfa; }

/* ── 按钮 ─────────────────────────────────────── */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: #047857;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  padding: 0 30rpx;
  line-height: 1;
  /* 按钮常被写成「内联 width:100%」撑满一行。
     content-box 时总宽会多出左右各 30rpx、直接凸出卡片 ——
     这里显式声明，别再依赖全局 reset。 */
  box-sizing: border-box;
}

/* 禁用态：不用 opacity（会把文字和底色一起压淡），改用专用 token。
   .btn-primary 的主色变了，这里必须同步覆盖 background 和 color。 */
.btn-primary.is-disabled {
  background: var(--disabled-bg);
  border-color: var(--disabled-border);
  color: var(--disabled-text);
}

/* 小尺寸按钮变体 */
.btn-sm { height: 64rpx; font-size: 28rpx; padding: 0 22rpx; border-radius: 16rpx; box-sizing: border-box; }
.btn-xs { height: 52rpx; font-size: 24rpx; padding: 0 18rpx; border-radius: 12rpx; box-sizing: border-box; }

/* 按钮行：自动换行，避免窄屏挤压 */
.row-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.row-actions.mt { margin-top: 24rpx; margin-bottom: 0; }

.btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 76rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border-3);
  background: var(--surface-3);
  color: var(--text-2);
  font-size: 30rpx;
  font-weight: 500;
  padding: 0 30rpx;
  line-height: 1;
  box-sizing: border-box;
}

/* ── 输入 ─────────────────────────────────────── */
.input {
  width: 100%;
  height: 76rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border-3);
  background: var(--surface-3);
  padding: 0 22rpx;
  font-size: 30rpx;
  color: var(--text-1);
  box-sizing: border-box;
}

.input-ph { color: #64748b; }

/* ── 表单字段 ─────────────────────────────────── */
.field { margin-bottom: 20rpx; }

/* 两列并排；小程序不支持 subgrid，用 flex + min-width:0 防溢出 */
.field-row {
  display: flex;
  gap: 18rpx;
}

.field-row .field {
  flex: 1;
  min-width: 0;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 8rpx;
}

.field-hint {
  font-size: 24rpx;
  color: var(--text-4);
  margin-top: 8rpx;
}

/* picker 的显示区，外观与 .input 一致 */
.picker {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border-3);
  background: var(--surface-3);
  padding: 0 22rpx;
  font-size: 30rpx;
  color: var(--text-1);
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ── 空状态 ───────────────────────────────────── */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 56rpx 0;
  text-align: center;
}

.empty-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--chip-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.empty-title {
  font-size: 30rpx;
  color: var(--text-3);
  font-weight: 500;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--text-4);
  line-height: 1.6;
  max-width: 460rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-4);
  line-height: 1.6;
  max-width: 460rpx;
}

/* ── 过滤胶囊行 ───────────────────────────────── */
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.filter-pill {
  border-radius: 999rpx;
  padding: 9rpx 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid var(--border-2);
  background: var(--surface-3);
  color: var(--text-3);
}

.filter-pill.is-active {
  background: #047857;
  border-color: #047857;
  color: #fff;
}

.filter-count { margin-left: 8rpx; opacity: 0.75; }

/* ── 进度条 ───────────────────────────────────── */
.bar-track {
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--surface-4);
  overflow: hidden;
  margin-top: 12rpx;
}

.bar-track-sm { margin-top: 0; height: 14rpx; }

/* 进度条填充。
   ── 性能：不要用 transition: width ──────────────────────────
   过渡 width 会让每一帧都触发 layout → paint → composite，
   而且进度条在总览/健康/饮食里是成组出现的，一屏十几条同时动，
   低端安卓机上直接掉帧。这是 v1.0.x「动画卡顿」的主因。

   改成 transform: scaleX() —— 只走 composite，不碰 layout。
   WXML 里两条信息都保留：
     width: X%    兜底，环境不支持 CSS 变量时仍能画对
     --bar: 0.xx  给这里做 scaleX 动画
   width 和 scaleX 同时生效会「宽度 × 缩放」算两遍，所以下面用
   @supports 做能力检测：支持时把 width 交给 transform 接管，
   不支持才退回纯 width。 */
.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #047857;
  transform-origin: left center;
  transition: transform 0.25s cubic-bezier(0.22, 0.61, 0.36, 1);
}

@supports (transform: scaleX(var(--bar, 1))) {
  .bar-fill {
    width: 100% !important;
    transform: scaleX(var(--bar, 1));
    will-change: transform;
  }
}

.bar-emerald { background: #10b981; }
.bar-amber   { background: #f59e0b; }
.bar-sky     { background: #0ea5e9; }
.bar-rose    { background: #f43f5e; }
.bar-violet  { background: #8b5cf6; }

/* ── 大数字统计 ───────────────────────────────── */
.big-stat {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.big-num {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}

.big-unit {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-4);
}

.big-side {
  font-size: 28rpx;
  color: var(--text-3);
}

.big-pct {
  font-size: 30rpx;
  font-weight: 700;
  color: #34d399;
}

.big-pct-unit { font-size: 24rpx; color: var(--text-4); }

/* ── 胶囊行 ───────────────────────────────────── */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

/* ── 说明条目 ─────────────────────────────────── */
.bullet {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.bullet-dot {
  color: #10b981;
  font-size: 28rpx;
  line-height: 1.5;
  flex-shrink: 0;
}

.bullet-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.bullet-note {
  font-size: 28rpx;
  color: var(--text-3);
  line-height: 1.8;
}

.tip-box {
  margin-top: 18rpx;
  border-radius: 16rpx;
  background: rgba(16, 185, 129, 0.1);
  border: 2rpx solid rgba(16, 185, 129, 0.28);
  padding: 18rpx 22rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #6ee7b7;
  line-height: 1.7;
}

.inline-hint {
  font-size: 28rpx;
  color: var(--text-4);
  line-height: 1.7;
}

.tiny-note {
  font-size: 24rpx;
  color: var(--text-4);
  line-height: 1.7;
  margin-top: 14rpx;
}

.tiny-note.mt { margin-top: 18rpx; }

/* ── 通用记录列表 ─────────────────────────────── */
.log-list { margin-top: 4rpx; }

.log-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--surface-3);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 12rpx;
}

.log-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #f59e0b;
  flex-shrink: 0;
}

.log-dot.is-primary { background: #10b981; }

.log-date {
  font-size: 28rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.log-type {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.btn-mini {
  width: 52rpx;
  height: 52rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
}

/* ── 每周分布 ─────────────────────────────────── */
.week-bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.week-bar-label {
  width: 110rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.week-bar-label.is-current {
  color: #34d399;
  font-weight: 600;
}

.week-bar-row .bar-track { flex: 1; min-width: 0; }

.week-bar-count {
  width: 80rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

/* 强调色幽灵按钮 */
.btn-ghost.btn-emerald {
  border-color: rgba(16, 185, 129, 0.4);
  color: #6ee7b7;
  background: rgba(16, 185, 129, 0.1);
}

.btn-ghost.is-disabled {
  background: var(--disabled-bg);
  border-color: var(--disabled-border);
  color: var(--disabled-text);
}

/* ── 指标卡网格（总览 / 体重作息共用） ─────────── */
/* 用 grid 而不是 flex-wrap + calc：小程序里 flex 的百分比宽度
   在 gap 参与计算时容易溢出或被挤压，grid 更稳。 */
.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  box-sizing: border-box;
  background: var(--surface-1);
  border: 2rpx solid var(--border-1);
  border-radius: 24rpx;
  padding: 24rpx 24rpx 22rpx;
  min-width: 0; /* 允许内部文字省略号生效，避免撑破格子 */
}

.stat-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.stat-label {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-4);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-value {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 16rpx;
}

.stat-num {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-1);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.stat-unit { font-size: 24rpx; color: var(--text-4); }

.stat-card .chip { margin-top: 16rpx; }

/* ── 勾选框（多个页面共用） ───────────────────── */
.checkbox {
  width: 42rpx;
  height: 42rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--border-3);
  background: var(--surface-1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  flex-shrink: 0;
}

.checkbox.is-on {
  background: #047857;
  border-color: #047857;
}

/* ── 开关行（标签 + switch） ──────────────────── */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0 20rpx;
}

.switch-row:last-of-type { padding-bottom: 0; }

.switch-label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-3);
}

/* ── 信息提示条 ───────────────────────────────── */
.msg-box {
  background: rgba(14, 165, 233, 0.1);
  border: 2rpx solid rgba(14, 165, 233, 0.3);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  color: #7dd3fc;
  line-height: 1.7;
  margin-bottom: 18rpx;
}

/* ── 小图标按钮（列表行内的编辑 / 删除） ──────── */
/* 微信设计指南 3.2：适宜点击的物理尺寸约 7mm–9mm。
   屏幕上 1px ≈ 0.26mm，所以 7mm ≈ 27px。原来这里是 56rpx（=28px）
   的**视觉尺寸**，但热区等于视觉尺寸，在手指较粗或边框圆角附近就点不准。
   现在保留 56rpx 的视觉外观，用 padding 把实际热区撑到 88rpx（=44px，
   正是 iOS HIG 与微信 WeUI 共同采用的最小热区）。

   写法说明：padding + 负 margin 让热区变大而外观不变 —— 若直接放大盒子，
   列表行会被撑高、行距变稀，视觉上更散。 */
.icon-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  flex-shrink: 0;
  box-sizing: content-box;
  padding: 16rpx;
  margin: -16rpx;
  background: var(--chip-bg);
  border: 2rpx solid var(--border-2);
}

/* 需要强调的（删除等）用 tone-* 上色，尺寸不变 */
.icon-btn.tone-rose {
  background: rgba(244, 63, 94, 0.14);
  border-color: rgba(244, 63, 94, 0.3);
}

.icon-btn.tone-emerald {
  background: rgba(16, 185, 129, 0.14);
  border-color: rgba(16, 185, 129, 0.3);
}

/* 更小的变体：和历史行、清单行一起用 */
.icon-btn.btn-mini {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

/* ── 行内强调文字（分析 / 设置共用） ───────────── */
.hl {
  color: #34d399;
  font-weight: 600;
}
/* ══════════════════════════════════════════════════════════════
   v1.1.0 · 结构规范（对齐 WeUI 的布局语言，不引 WeUI 包）
   ─────────────────────────────────────────────────────────────
   为什么不上 WeUI 组件包：
   本项目已经有一套调好的双主题 token（--surface-* / --text-*），
   WeUI 自带的浅色+微信绿会把它们顶掉，等于推翻 96KB 现成样式，
   体积还要再多 ~100KB。这里只借 WeUI 三个真正有用的结构约定：
     1. cell 列表：发丝线分隔 + 统一高度节奏
     2. 8rpx 基准间距梯度
     3. 按压态反馈（weui-active 的等价物）
   样式全部映射到本项目 token，深色/浅色两套主题自动跟随。
   ══════════════════════════════════════════════════════════════ */

/* ── 间距梯度（8rpx 基准，对齐 WeUI 的 16px 栅格） ── */
.gap-1 { gap: 8rpx; }
.gap-2 { gap: 16rpx; }
.gap-3 { gap: 24rpx; }

/* ── cell 列表：WeUI weui-cells 的等价实现 ──────────
   用例：设置项、历史记录、清单。比 log-row 更适合「逐行读」的内容：
   相邻行之间用发丝线，而不是每行一个独立方块 —— 视觉噪音更小。
   注意用 :first-child/:last-child 去掉首尾的线，避免和卡片边缘重叠。 */
.cells {
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--surface-2);
  border: 2rpx solid var(--border-1);
}

.cell {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 22rpx 26rpx;
  background: var(--surface-1);
  position: relative;
}

/* 分隔线用伪元素，避免 border 影响高度计算 */
.cell + .cell::before {
  content: '';
  position: absolute;
  left: 26rpx;
  right: 0;
  top: 0;
  height: 2rpx;
  background: var(--border-1);
  transform: scaleY(0.5);
  transform-origin: top;
}

.cell-main { flex: 1; min-width: 0; }

.cell-title {
  font-size: 30rpx;
  color: var(--text-1);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-desc {
  font-size: 28rpx;
  color: var(--text-4);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-extra {
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

/* 右侧箭头：用 CSS 画的 chevron，不依赖字体图标 */
.cell-arrow { position: relative; padding-right: 26rpx; }
.cell-arrow::after {
  content: '';
  position: absolute;
  right: 6rpx;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  margin-top: -6rpx;
  border-right: 3rpx solid var(--text-4);
  border-bottom: 3rpx solid var(--text-4);
  transform: rotate(-45deg);
}

/* ── 按压态（WeUI weui-active 的等价物） ────────────
   统一给可点击元素加 class="tap"，只改 opacity/transform，
   不触发 layout。 */
.tap {
  transition: opacity 0.12s ease, transform 0.12s ease;
}

.tap-active,
.tap:active {
  opacity: 0.72;
  transform: scale(0.985);
}

/* ── 全局兜底按压反馈（2026-10-30）────────────────────────────
   微信设计指南 2.2「减少等待，反馈及时」和「页面局部操作结果反馈」
   都要求：用户点下去要**立刻**有视觉回应。

   实测全站 262 个 bindtap/catchtap 里只有 3 个带了 .tap，
   也就是说 98% 的可点区域按下去毫无反应 —— 用户会以为没点上，
   于是连点，反而触发重复操作。

   逐个行加 class="tap" 要改 16 个 WXML、漏一个就退回原状，
   所以这里从「组件形态」侧解决：给项目里实际在用的几种可点容器
   统一挂按压态。transform/opacity 都走合成层，不触发 layout，
   符合上面的性能红线。

   例外：.bar / .bar-fill（进度条不是可点元素）不在此列。 */
.nav-item:active,
.mini-row:active,
.course-item:active,
.todo-line:active,
.hist-day:active,
.pin-card:active,
.pin-add:active,
.stat-card:active,
.seg-item:active,
.cell:active,
.btn-primary:active,
.btn-ghost:active,
.btn-sm:active,
.icon-btn:active,
.head-link:active,
.ai-btn:active,
.ai-choice:active,
.filter-pill:active,
.chip:active,
.week-setup-go:active,
.date-nav:active {
  opacity: 0.72;
  transition: opacity 0.1s ease;
}

/* filter-pill 补按压态（原来只有选中态） */
.filter-pill.tap:active {
  transform: scale(0.96);
}

/* ══════════════════════════════════════════════════════════════
   v1.1.0 · 动效
   ─────────────────────────────────────────────────────────────
   ⚠ 性能红线 —— 只允许过渡这两个属性：
       transform / opacity
   因为它们只走 composite 阶段，GPU 直接合成。
   以下属性一律禁止用于 transition（会导致逐帧 layout/paint，
   在低端安卓上表现为掉帧、滚动发涩）：
       width  height  top  left  right  bottom
       margin  padding  border-width  font-size
       box-shadow（大面积阴影尤其致命）
   新增动画前先确认落在允许清单里。
   ══════════════════════════════════════════════════════════════ */

/* 卡片入场：只做透明度淡入。
   ── 为什么去掉了位移和逐条延迟 ───────────────────────────────
   原来这里是「上浮 16rpx + 每条递增 0.03s 延迟（最多 0.18s）+ 0.28s 时长」，
   合计最长要 0.46s 后整页才稳定。这带来两个实际问题：
     1. 截图/录屏在动画中途拍到的就是「卡片错位、像重叠」的画面 ——
        交接文档里记的「模拟器看起来时好时坏」有一半是这个造成的；
     2. 首屏信息在 0.46s 内处于半透明、位置偏移的状态，用户读不到东西。
   微信官方设计指引要求反馈克制、内容优先，入场动画不该延迟内容可读性。
   现在只留 0.18s 的透明度淡入，不移动任何元素，任何一帧截下来布局都是对的。 */
@keyframes rise-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.rise-in {
  animation: rise-in 0.18s ease-out both;
}

/* 逐条延迟全部归零（保留 d1..d6 类名，WXML 不用改）。
   同一屏卡片依次错开出现属于「炫技式」动效，不承载信息。 */
.rise-in.d1,
.rise-in.d2,
.rise-in.d3,
.rise-in.d4,
.rise-in.d5,
.rise-in.d6 {
  animation-delay: 0s;
}

/* 动画结束后释放合成层，避免长期占用显存 */
.rise-in {
  animation-fill-mode: both;
}
.rise-in.done {
  animation: none;
  opacity: 1;
  transform: none;
}

/* 数字出现的轻微淡入（大数字统计用）。
   同样去掉位移：数字位置跳动会让人误以为数值在变。 */
@keyframes num-pop {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.num-pop {
  animation: num-pop 0.18s ease-out both;
}

/* 分段切换：只淡入，不横移 */
@keyframes fade-slide {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.seg-item.is-active .seg-label,
.seg-item.is-active .seg-icon {
  animation: fade-slide 0.15s ease-out;
}

/* ── 无障碍：用户开了「减弱动态效果」时全部关掉 ──
   这是系统级设置，尊重它比“好看”重要。 */
@media (prefers-reduced-motion: reduce) {
  .rise-in,
  .rise-in.d1, .rise-in.d2, .rise-in.d3,
  .rise-in.d4, .rise-in.d5, .rise-in.d6,
  .num-pop,
  .bar-fill,
  .seg-item.is-active .seg-label,
  .seg-item.is-active .seg-icon {
    animation: none !important;
    transition: none !important;
    transform: none;
    opacity: 1;
  }
}
